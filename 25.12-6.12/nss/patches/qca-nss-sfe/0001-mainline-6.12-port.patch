diff -ruN buildroot/qca/src/nss/clients/qca-nss-sfe/sfe_compat.h buildroot-25.12-6.12/qca/src/nss/clients/qca-nss-sfe/sfe_compat.h
--- a/sfe_compat.h	1970-01-01 00:00:00.000000000 +0000
+++ b/sfe_compat.h	2026-10-24 10:19:10.849905886 +0000
@@ -0,0 +1,213 @@
+/*
+ * sfe_compat.h
+ *	Mainline Linux compatibility layer for the SFE port.
+ *
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ *
+ * The QSDK 6.6 vendor kernel adds several things to the networking core
+ * that mainline Linux 6.12 does not have.  SFE uses them only on the
+ * accelerator paths, so they are mapped onto mainline equivalents here:
+ *
+ *  - <linux/debug_mem_usage.h> and its mem_debug_update_skb() hooks only
+ *    exist with CONFIG_DEBUG_MEM_USAGE in the vendor kernel; they become
+ *    no-ops.
+ *
+ *  - dev_fast_xmit() and dev_fast_xmit_qdisc() call into the driver's
+ *    ndo_fast_xmit handler, bypassing the qdisc.  Mainline has neither the
+ *    handler nor the skb flags it uses.  sfe_fast_xmit() performs the same
+ *    protocol setup and hands the packet to dev_queue_xmit(), which owns
+ *    the skb either way, so the packet is still delivered; only the qdisc
+ *    bypass (and, for the qdisc variant, shaping on a separate top
+ *    interface) is lost.  This is a behaviour gap of the mainline port.
+ *
+ *  - skb_set_int_pri()/skb_get_int_pri() carry the EDMA Rx interrupt
+ *    priority into the Tx descriptor.  struct sk_buff has no spare field
+ *    for it and reusing skb->priority would change qdisc classification,
+ *    so the value is not propagated.
+ *
+ *  - struct netdev_hw_offload_ops and the dev->offload_ops field are
+ *    restored by the qualcommbe kernel patch (0378).  The semantics are
+ *    the vendor kernel's, so sfe_netdev_offload_ops() reads the field
+ *    unchanged and reports "no offload" until a driver registers ops.
+ */
+
+#ifndef __SFE_COMPAT_H
+#define __SFE_COMPAT_H
+
+#include <linux/netdevice.h>
+#include <linux/skbuff.h>
+#include <linux/rcupdate.h>
+
+#ifndef mem_debug_update_skb
+#define mem_debug_update_skb(skb)		do { } while (0)
+#define mem_debug_update_skb_list(skb_list)	do { } while (0)
+#endif
+
+#ifndef netdev_alloc_skb_fast
+#define netdev_alloc_skb_fast(dev, len)		netdev_alloc_skb((dev), (len))
+#endif
+
+static inline void skb_set_int_pri(struct sk_buff *skb, u8 int_pri)
+{
+}
+
+static inline u8 skb_get_int_pri(const struct sk_buff *skb)
+{
+	return 0;
+}
+
+/*
+ * sfe_fast_xmit()
+ *	Transmit through the regular stack.
+ */
+static inline bool sfe_fast_xmit(struct sk_buff *skb, struct net_device *dev,
+		netdev_features_t features)
+{
+	skb->dev = dev;
+	dev_queue_xmit(skb);
+
+	return true;
+}
+
+#define dev_fast_xmit(skb, dev, features) \
+	sfe_fast_xmit((skb), (dev), (features))
+
+static inline bool sfe_fast_xmit_qdisc(struct sk_buff *skb, struct net_device *dev,
+		struct net_device *top_qdisc_dev)
+{
+	skb->dev = dev;
+	dev_queue_xmit(skb);
+
+	return true;
+}
+
+#define dev_fast_xmit_qdisc(skb, dev, top_qdisc_dev) \
+	sfe_fast_xmit_qdisc((skb), (dev), (top_qdisc_dev))
+
+/*
+ * Hardware offload transmit hooks.  struct netdev_hw_offload_ops and the
+ * dev->offload_ops field come from the qualcommbe kernel patch restoring
+ * QSDK's ABI; no mainline driver registers ops, so this is NULL until one
+ * does, exactly as on the vendor kernel.
+ */
+static inline struct netdev_hw_offload_ops *sfe_netdev_offload_ops(struct net_device *dev)
+{
+	return rcu_dereference(dev->offload_ops);
+}
+
+/*
+ * linux/if_trustsec.h and vlan_dev_next_dev() are QSDK kernel additions.
+ * The trustsec definitions are plain UAPI-style structures and helpers, so
+ * they are reproduced verbatim here (same ISC license); the VLAN helper is
+ * the single-level variant of mainline's vlan_dev_real_dev().
+ */
+#include <linux/if_vlan.h>
+
+#define TRUSTSEC_HLEN	6			/* The additional bytes required by trustsec header. */
+#define ETH_P_TRSEC	0x8909			/* Protocol number for trustsec header. */
+
+#define TRUSTSEC_META_HDR_VERSION 0x1		/* Meta header version number. */
+#define TRUSTSEC_META_HDR_LEN 0x1		/* trustsec meta header length. */
+#define TRUSTSEC_PAYLOAD_LEN 0x0		/* Length of the payload. */
+#define TRUSTSEC_PAYLOAD_OPT_TYPE 0x0001	/* Option type field. */
+
+struct trustsec_hdr {
+	u8 meta_hdr_ver;
+	u8 meta_hdr_len;
+#if defined(__BIG_ENDIAN_BITFIELD)
+	u16 payload_len:3;
+	u16 payload_opt_type :13;
+#else
+	u16 payload_opt_type :13;
+	u16 payload_len:3;
+#endif
+	__be16 sgt;
+};
+
+static inline struct trustsec_hdr *trustsec_get_hdr(const struct sk_buff *skb)
+{
+	return (struct trustsec_hdr *)skb_network_header(skb);
+}
+
+static inline void trustsec_insert_hdr(struct sk_buff *skb, __be16 sgt)
+{
+	struct trustsec_hdr *thdr;
+
+	thdr = (struct trustsec_hdr *)skb_push(skb, TRUSTSEC_HLEN);
+	thdr->meta_hdr_ver = TRUSTSEC_META_HDR_VERSION;
+	thdr->meta_hdr_len = TRUSTSEC_META_HDR_LEN;
+	thdr->payload_len = htons(TRUSTSEC_PAYLOAD_LEN);
+	thdr->payload_opt_type = htons(TRUSTSEC_PAYLOAD_OPT_TYPE);
+	thdr->sgt = sgt;
+	skb->protocol = htons(ETH_P_TRSEC);
+}
+
+/*
+ * sfe_vlan_dev_next_dev()
+ *	Return the device a VLAN interface is stacked on (one level).
+ */
+static inline struct net_device *sfe_vlan_dev_next_dev(const struct net_device *dev)
+{
+	return vlan_dev_priv(dev)->real_dev;
+}
+
+#define vlan_dev_next_dev(dev)	sfe_vlan_dev_next_dev((dev))
+
+/*
+ * include/net/gre.h in the vendor kernel adds these two helpers; mainline
+ * only carries the *tretap variants.
+ */
+#include <net/gre.h>
+
+static inline bool netif_is_gre(const struct net_device *dev)
+{
+	return dev->rtnl_link_ops && !strcmp(dev->rtnl_link_ops->kind, "gre");
+}
+
+static inline bool netif_is_ip6gre(const struct net_device *dev)
+{
+	return dev->rtnl_link_ops && !strcmp(dev->rtnl_link_ops->kind, "ip6gre");
+}
+
+/*
+ * IPPROTO_ETHERIP is defined by the vendor kernel's uapi/linux/in.h but no
+ * longer by mainline; value from RFC 3378 / IANA.
+ */
+#ifndef IPPROTO_ETHERIP
+#define IPPROTO_ETHERIP	97
+#endif
+
+/*
+ * QSDK adds priv_flags_ext with IFF_EXT_MAPT / IFF_EXT_ETH_L2TPV3 to struct
+ * net_device (set by the MAP-T and L2TPv3 ethernet drivers).  Mainline has
+ * neither the field nor those drivers, so the flags always read as clear and
+ * these interfaces are classified like any other device.
+ */
+#define IFF_EXT_MAPT		0
+#define IFF_EXT_ETH_L2TPV3	0
+
+static inline unsigned long sfe_dev_priv_flags_ext(const struct net_device *dev)
+{
+	return 0;
+}
+
+/*
+ * sfe_kfree_skb_list_fast()
+ *	Free a queue of skbs that have already been accounted as consumed.
+ *
+ * The vendor helper hands the buffers back to the skb recycler in one go;
+ * without a recycler this is the plain per-skb consume path.
