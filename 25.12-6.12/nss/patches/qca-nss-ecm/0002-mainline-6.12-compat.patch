+/*
+ **************************************************************************
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ ***************************************************************************
+ */
+
+/*
+ * 6.12 mainline port (SBE1V1K, stage W1).
+ *
+ * The QSDK kernel carries a set of net_device/skb extensions that ECM uses
+ * to recognise offload-relevant interface classes.  Mainline 6.12 has none
+ * of them, so this header provides the minimum needed to build and keeps the
+ * behaviour explicit.  Every deviation is listed here rather than hidden in
+ * the call sites.
+ *
+ * 1. priv_flags_ext
+ *	QSDK adds 'unsigned int priv_flags_ext' to struct net_device and the
+ *	IFF_EXT_* bits below.  Drivers set them in tun.c, ifb.c, ppp_generic.c,
+ *	l2tp_eth.c, gre.c, mapt and the QSDK tunnel code.  Mainline keeps no
+ *	such field.
+ *
+ *	ecm_netdev_priv_flags_ext() returns 0, i.e. "no extended flag set".
+ *	Consequences, all confined to non-Ethernet tunnel devices:
+ *	  - ecm_interface_hierarchy_is_tunnel_dev() still classifies tunnels by
+ *	    dev->type and by the name of the tunnel netdev (its primary check,
+ *	    done before the flag test), so ordinary GRE/IPIP/SIT/VXLAN/GENEVE
+ *	    tunnels remain detected;
+ *	  - tunnels that only the flag would have caught (tun/tap, L2TPv3
+ *	    Ethernet, MAP-T, PPP-over-L2TP/PPTP) are treated as plain devices.
+ *	    ECM_INTERFACE_L2TPV3/PTPT/OVPN/MAP_T support is therefore inert.
+ *	  - IFF_EXT_HW_NO_OFFLOAD has no writer anywhere in the QSDK source
+ *	    either, so "this interface must not be offloaded" is always false
+ *	    on both builds.
+ *	For the W1 target (Ethernet WAN, bridged/VLAN Ethernet LAN) none of
+ *	these device classes exist, so the datapath decisions are unchanged.
+ *
+ * 2. skb->int_pri
+ *	QSDK adds an 8-bit internal priority to struct sk_buff, used only by
+ *	the PPE QoS mapping.  Mainline has no equivalent; reading it yields 0
+ *	and writing it is a no-op, so PPE QoS rules see priority 0.  Interface
+ *	and flow classification are unaffected.
+ *
+ * 3. ppp_is_xmit_locked()
+ *	QSDK exports this from ppp_channel.c.  Mainline has no such helper;
+ *	ECM used it to avoid offloading packets while the PPP tx path is
+ *	locked.  Reporting "not locked" preserves the ordinary (unlocked)
+ *	behaviour; PPP interfaces are not a W1 target.
+ *
+ * 4. vlan_dev_next_dev()
+ *	QSDK rename of mainline's vlan_dev_real_dev(); mapped directly.
+ *
+ * 5. IPPROTO_ETHERIP
+ *	Present in QSDK's uapi/linux/in.h, absent from mainline 6.12.  Value
+ *	97 is the IANA assignment, identical to QSDK.
+ */
+#ifndef __ECM_NETDEV_COMPAT_H
+#define __ECM_NETDEV_COMPAT_H
+
+#include <linux/kernel.h>
+#include <linux/netdevice.h>
+#include <linux/skbuff.h>
+#include <linux/if_vlan.h>
+#include <linux/if_bridge.h>
+
+/*
+ * QSDK include/linux/netdevice.h: enum netdev_priv_flags_ext.
+ * Values are kept identical so that the ECM tests read the same way.
+ */
+enum ecm_netdev_priv_flags_ext {
+	IFF_EXT_TUN_TAP		= 1 << 0,
+	IFF_EXT_PPP_L2TPV2	= 1 << 1,
+	IFF_EXT_PPP_L2TPV3	= 1 << 2,
+	IFF_EXT_PPP_PPTP	= 1 << 3,
+	IFF_EXT_GRE_V4_TAP	= 1 << 4,
+	IFF_EXT_GRE_V6_TAP	= 1 << 5,
+	IFF_EXT_IFB		= 1 << 6,
+	IFF_EXT_MAPT		= 1 << 7,
+	IFF_EXT_HW_NO_OFFLOAD	= 1 << 8,
+	IFF_EXT_ETH_L2TPV3	= 1 << 9,
+};
+
+/*
+ * No mainline interface is ever marked with an extended flag; see 1. above.
+ */
+static inline unsigned int ecm_netdev_priv_flags_ext(const struct net_device *dev)
+{
+	return 0;
+}
+
+/* QSDK skb->int_pri; see 2. above. */
+static inline u8 ecm_skb_int_pri(const struct sk_buff *skb)
+{
+	return 0;
+}
+
+static inline void ecm_skb_set_int_pri(struct sk_buff *skb, u8 int_pri)
+{
+}
+
+/* QSDK ppp_is_xmit_locked(); see 3. above. */
+static inline bool ecm_ppp_is_xmit_locked(struct net_device *dev)
+{
+	return false;
+}
+
+/*
+ * QSDK include/linux/if_vlan.h: vlan_dev_next_dev().  Mainline exposes the
+ * same operation as vlan_dev_real_dev().
+ */
+#define ecm_vlan_dev_next_dev(dev)	vlan_dev_real_dev(dev)
+
+/* See 5. above. */
+#ifndef IPPROTO_ETHERIP
+#define IPPROTO_ETHERIP	97
+#endif
+
+/*
+ * 6. PPP channel API
+ *	QSDK extends include/linux/ppp_channel.h with helpers that let an
+ *	offload engine inspect and account the channels behind a PPP netdev.
+ *	Mainline exports only ppp_register_channel()/ppp_unregister_channel().
+ *
+ *	ppp_hold_channels() reports "no channel could be taken", which is the
+ *	condition ECM already handles by establishing the device as
+ *	ECM_DB_IFACE_TYPE_UNKNOWN.  PPP, PPPoE, PPTP and L2TPv2 interfaces are
+ *	therefore not accelerated; everything else in the datapath is
+ *	unaffected.  ppp_update_stats() becomes a no-op, so offloaded byte and
+ *	packet counts are not folded back into the PPP netdev counters.
+ */
+struct ppp_channel;
+struct pppoe_opt;
+
+static inline int ecm_ppp_hold_channels(struct net_device *dev,
+					struct ppp_channel *channels[],
+					unsigned int chan_sz)
+{
+	return 0;
+}
+
+static inline void ecm_ppp_release_channels(struct ppp_channel *channels[],
+					    unsigned int chan_sz)
+{
+}
+
+static inline int ecm_ppp_channel_get_protocol(struct ppp_channel *chan)
+{
+	return -EOPNOTSUPP;
+}
+
+static inline int ecm_pppoe_channel_addressing_get(struct ppp_channel *chan,
+						   struct pppoe_opt *addressing)
+{
+	return -EOPNOTSUPP;
+}
+
+static inline int ecm_ppp_is_multilink(struct net_device *dev)
+{
+	return 0;
+}
+
+#define ppp_hold_channels		ecm_ppp_hold_channels
+#define ppp_release_channels		ecm_ppp_release_channels
+#define ppp_channel_get_protocol	ecm_ppp_channel_get_protocol
+#define pppoe_channel_addressing_get	ecm_pppoe_channel_addressing_get
+#define ppp_is_multilink		ecm_ppp_is_multilink
+
+static inline void ppp_update_stats(struct net_device *dev,
+				    unsigned long rx_packets,
+				    unsigned long rx_bytes,
+				    unsigned long tx_packets,
+				    unsigned long tx_bytes,
+				    unsigned long rx_errors,
+				    unsigned long tx_errors,
+				    unsigned long rx_dropped,
+				    unsigned long tx_dropped)
+{
+}
+
+/*
+ * 7. DSA
+ *	Mainline renamed dsa_slave_dev_check() to dsa_user_dev_check() and
+ *	replaced the cpu_dp->master netdev pointer with dsa_port_to_conduit().
+ *	Both are straight renames, so the DSA interface path keeps working.
+ */
+#define dsa_slave_dev_check(dev)	dsa_user_dev_check(dev)
+
+/*
+ * 8. MAP-T
+ *	QSDK's nat46 exports is_map_t_dev().  The nat46 shipped for this build
+ *	has no MAP-T netdev support, so no device is ever a MAP-T device.
+ */
+static inline bool is_map_t_dev(const struct net_device *dev)
+{
+	return false;
+}
+
+/*
+ * 9. Offload statistics helpers
+ *	QSDK lets an offload engine push its counters into the bridge, bridge
+ *	VLAN, VLAN and DSA devices.  Mainline has no such entry points.
+ *
+ *	Offloaded traffic is then missing from those device counters only;
+ *	per-interface counters and the accelerated datapath are unaffected.
+ *	br_vlan_update_stats() returns 0 so that ECM does not log a failure for
+ *	every update.
+ */
+static inline void br_dev_update_stats(struct net_device *dev,
+				       struct rtnl_link_stats64 *nlstats)
+{
+}
+
+static inline int br_vlan_update_stats(struct net_device *dev, u32 vid,
+				       u64 rx_bytes, u64 rx_packets,
+				       u64 tx_bytes, u64 tx_packets)
+{
+	return 0;
+}
+
+static inline void __vlan_dev_update_accel_stats(struct net_device *dev,
+						 struct rtnl_link_stats64 *stats)
+{
+}
+
+static inline void __dsa_dev_update_accel_stats(struct net_device *dev,
+						struct rtnl_link_stats64 *stats)
+{
+}
+
+/*
+ * 10. Bridge FDB and neighbour MAC change events
+ *	QSDK's bridge code publishes MAC add/delete/move events so that ECM
+ *	can defunct the connections of a station that roamed or aged out; the
+ *	qualcommbe kernel patch restores those chains on mainline 6.12, so
+ *	ECM uses the real ones.  The no-op fallback below only applies to a
+ *	kernel without the patch (BR_FDB_EVENT_ADD undefined).
+ *
+ *	Only the neighbour-side events remain stubbed: QSDK's
+ *	neigh_mac_update chains are not part of the restored ABI.
+ */
+#ifndef BR_FDB_EVENT_ADD
+struct net_bridge;
+
+struct br_fdb_event {
+	unsigned char addr[6];
+	unsigned char is_local;
+	struct net_device *dev;
+	struct net_bridge *br;
+	struct net_device *orig_dev;
+};
+
+#define BR_FDB_EVENT_ADD	0x01
+#define BR_FDB_EVENT_DEL	0x02
+
+static inline void br_fdb_update_register_notify(struct notifier_block *nb)
+{
+}
+
+static inline void br_fdb_update_unregister_notify(struct notifier_block *nb)
+{
+}
+
+static inline void br_fdb_register_notify(struct notifier_block *nb)
+{
+}
+
+static inline void br_fdb_unregister_notify(struct notifier_block *nb)
+{
+}
+#endif /* !BR_FDB_EVENT_ADD */
+
+struct neigh_mac_update {
+	unsigned char old_mac[ALIGN(MAX_ADDR_LEN, sizeof(unsigned long))];
+	unsigned char update_mac[ALIGN(MAX_ADDR_LEN, sizeof(unsigned long))];
+};
+
+static inline void neigh_mac_update_register_notify(struct notifier_block *nb)
+{
+}
+
+static inline void neigh_mac_update_unregister_notify(struct notifier_block *nb)
+{
+}
+
+/*
+ * 11. Bridge isolation
+ *	QSDK tags bridge ports with a "sub bridge id" so that ECM never
+ *	accelerates between isolated bridges.  Mainline has no such tag.
+ *	Reporting -EOPNOTSUPP makes the check fail closed: traffic is not
+ *	accelerated while the ecm_interface bridge_isolation knob is enabled,
+ *	which is the safe direction.  The knob defaults to off.
+ */
+static inline int br_port_get_sub_br_id(struct net_device *dev)
+{
+	return -EOPNOTSUPP;
+}
+
+/*
+ * 12. Bonding driver callbacks
+ *	QSDK's bonding driver exports struct bond_cb and
+ *	bond_register_cb()/bond_unregister_cb() so that an offload engine is
+ *	told when a LAG member changes state (link up/down, enslave/release).
+ *	Mainline exports neither; it only reports LAG state through netdevice
+ *	notifier events, which ECM already handles for the master device.
+ *
+ *	Consequence: a LAG member link flap or release does not defunct the
+ *	connections riding the master at the moment it happens; they are
+ *	invalidated by the next event or by their own timeout.  W1 has no LAG
+ *	configured (single Ethernet WAN, bridged Ethernet LAN), so this stub
+ *	is inert.
+ */
+struct bond_cb {
+	void (*bond_cb_link_up)(struct net_device *slave);
+	void (*bond_cb_link_down)(struct net_device *slave);
+	void (*bond_cb_enslave)(struct net_device *slave);
+	void (*bond_cb_release)(struct net_device *slave);
+	void (*bond_cb_delete_by_slave)(struct net_device *slave);
+	void (*bond_cb_delete_by_mac)(uint8_t *mac_addr);
+};
+
+static inline int ecm_bond_register_cb(struct bond_cb *cb)
+{
+	return 0;
+}
+
+static inline void ecm_bond_unregister_cb(void)
+{
+}
