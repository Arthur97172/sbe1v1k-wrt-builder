+++ b/frontends/include/net/netfilter/nf_conntrack_dscpremark_ext.h
@@ -0,0 +1,94 @@
+/*
+ **************************************************************************
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ ***************************************************************************
+ */
+
+/*
+ * 6.12 mainline port (SBE1V1K, stage W1).
+ *
+ * QSDK adds a conntrack extension that stores per-direction DSCP/priority/mark
+ * values filled in by its iptables DSCP target, keyed on the
+ * CONFIG_NF_CONNTRACK_DSCPREMARK_EXT option.  Mainline 6.12 has neither the
+ * option nor the extension, so the ECM DSCP classifier cannot be fed from
+ * conntrack.
+ *
+ * This header mirrors the QSDK API with the extension permanently absent,
+ * which is exactly the QSDK header's behaviour when its Kconfig option is
+ * disabled: find/add return NULL and the validity check reports
+ * RULE_NOT_VALID.  ECM already handles that case -
+ * ecm_classifier_dscp_process() marks the classifier irrelevant when the
+ * extension is missing, and ecm_front_end_tcp_set_dscp_ext() does nothing.
+ *
+ * Behavioural consequence: DSCP-based QoS/marking offload is inactive;
+ * ordinary connection tracking and all datapath acceleration are unaffected.
+ * The type is kept complete so that the ECM sources compile unchanged.
+ *
+ * Path note: this file is reached through the compiler's
+ * -I$(obj)/frontends/include from the ECM Makefile.
+ */
+#ifndef _NF_CONNTRACK_DSCPREMARK_H
+#define _NF_CONNTRACK_DSCPREMARK_H
+
+#include <net/netfilter/nf_conntrack.h>
+
+/* Rule flags */
+#define NF_CT_DSCPREMARK_EXT_DSCP_RULE_VALID	0x1
+
+/* Rule validity */
+#define NF_CT_DSCPREMARK_EXT_RULE_VALID		0x1
+#define NF_CT_DSCPREMARK_EXT_RULE_NOT_VALID	0x0
+
+/* Which QoS features are set flags */
+#define NF_CT_DSCPREMARK_EXT_PRIO	0x1
+#define NF_CT_DSCPREMARK_EXT_DSCP	0x2
+#define NF_CT_DSCPREMARK_EXT_IGS_QOS	0x4
+#define NF_CT_DSCPREMARK_EXT_MARK	0x8
+#define NF_CT_DSCPREMARK_EXT_SAWF	0x10
+
+/*
+ * DSCP remark conntrack extension structure (QSDK layout, kept for source
+ * compatibility; no instance exists on mainline).
+ */
+struct nf_ct_dscpremark_ext {
+	u32 flow_priority;
+	u32 reply_priority;
+	u32 flow_mark;
+	u32 reply_mark;
+	u32 flow_sawf_meta;
+	u32 return_sawf_meta;
+	u16 igs_flow_qos_tag;
+	u16 igs_reply_qos_tag;
+	u8 flow_dscp;
+	u8 reply_dscp;
+	u8 flow_int_pri;
+	u8 reply_int_pri;
+	u16 rule_flags;
+	u16 flow_set_flags;
+	u16 return_set_flags;
+};
+
+static inline struct nf_ct_dscpremark_ext *
+nf_ct_dscpremark_ext_find(const struct nf_conn *ct)
+{
+	return NULL;
+}
+
+static inline struct nf_ct_dscpremark_ext *
+nf_ct_dscpremark_ext_add(struct nf_conn *ct, gfp_t gfp)
+{
+	return NULL;
+}
+
+static inline int nf_conntrack_dscpremark_ext_set_dscp_rule_valid(struct nf_conn *ct)
+{
+	return -EOPNOTSUPP;
