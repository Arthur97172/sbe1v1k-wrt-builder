@@ -552,7 +552,15 @@
 	nf_conntrack_unregister_notifier(&init_net);
 #endif
 
+/*
+ * Mainline's nf_conntrack_register_notifier() returns void, so the only
+ * branch that can reach this label is the chain-events one.  Without the
+ * guard GCC's -Wunused-label (an error here) fires on the mainline path.
+ * The fallthrough from init_cleanup_2 still reaches the cleanup below.
+ */
+#ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
 init_cleanup_1:
+#endif
 	ecm_debugfs_remove_recursive(ecm_conntrack_notifier_dentry);
 	unregister_sysctl_table(ecm_conntrack_notifier_ctl_table_header);
 	return -1;
