+		uint16_t protocol, struct net_device *bond_dev,
+		__be16 *layer4hdr)
+{
+	return NULL;
+}
+
+#define bond_get_tx_dev	ecm_bond_get_tx_dev
+
+#endif /* __ECM_NETDEV_COMPAT_H */
