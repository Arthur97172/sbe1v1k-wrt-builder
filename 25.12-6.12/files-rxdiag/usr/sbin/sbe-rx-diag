#!/bin/sh
# 25.12 Rx 埋点读取器（SBE_DP_DIAG=1 的诊断镜像才有对应 proc 文件）。
#
#   sbe-rx-diag          # 打印当前计数器
#   sbe-rx-diag show     # 同上
#   sbe-rx-diag reset    # 清零计数器
#
# 输出字段见 docs/RX_DIAG_BUILD-2026-11-21.md。

F=/proc/edma_ring_util_stats/edma_rx_diag

[ -r "$F" ] || {
	echo "没有 $F：这不是带 Rx 埋点的诊断构建（SBE_DP_DIAG=1）" >&2
	exit 1
}

case "${1:-show}" in
show)
	cat "$F"
	;;
reset)
	echo 1 > "$F" && echo "counters reset"
	;;
*)
	echo "usage: sbe-rx-diag [show|reset]" >&2
	exit 1
	;;
esac
