#!/bin/sh /etc/rc.common
# 阶段标记 + 自救看门狗，见 /usr/sbin/sbe-diag-watchdog 的说明。
# 排在 S10boot 之前（S05）：模块加载卡死时它仍能把机器拉回 24.10。

START=05
STOP=90
# 不要写 USE_PROCD=0：rc.common 的 [ -n "$USE_PROCD" ] 把 "0" 也当开，
# 会覆盖掉下面的 start()，开机时看门狗根本不会被拉起。整行省略才对。

start() {
	/usr/sbin/sbe-diag-watchdog >/dev/null 2>&1 &
}

stop() {
	killall sbe-diag-watchdog 2>/dev/null
}
