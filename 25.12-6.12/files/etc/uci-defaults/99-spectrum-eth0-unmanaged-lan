#!/bin/sh
#
# 与 24.10-6.6 的 99-spectrum-eth0-unmanaged-lan 同一实现（该版本从厂商 rootfs
# 的 99-spectrum-eth0-unmanaged-lan-v4312 改编、并在真机上验证）。board.d
# 把 eth0 列进 LAN 只是为了让 board.json / LuCI 端口面板显示四个口；netifd
# 不能拥有 eth0，否则 LAN 地址变更时 RTL8261N/dp1 会进入假 10G 环回。
# 这里把它从生成的 br-lan 端口列表里摘出来，桥成员交给 eth0-lan-attach。
#
# 与厂商文件相比：去掉版本后缀；厂商专有的 lan-client-renew 与
# factory-eth-led 服务不启用（闭源厂商包，LICENSE_REVIEW_REQUIRED）；
# 保留对过时 lan-apply-watch 的清理，避免保留的旧 overlay 从原厂固件带回来。

[ "$(board_name 2>/dev/null)" = "spectrum,sbe1v1k" ] || exit 0

. /lib/functions.sh

remove_eth0_from_br_lan() {
	local section="$1"
	local name

	config_get name "$section" name
	[ "$name" = "br-lan" ] || return 0
	uci -q del_list "network.$section.ports=eth0"
}

config_load network
config_foreach remove_eth0_from_br_lan device
uci -q commit network

# Remove the obsolete helper even when it survived in a preserved overlay.
/etc/init.d/lan-apply-watch stop 2>/dev/null
/etc/init.d/lan-apply-watch disable 2>/dev/null
rm -f /etc/init.d/lan-apply-watch /usr/sbin/lan-apply-watch

/etc/init.d/eth0-lan-attach enable

exit 0
