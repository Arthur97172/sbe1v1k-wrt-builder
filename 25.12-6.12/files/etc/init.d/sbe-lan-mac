#!/bin/sh /etc/rc.common
#
# 板级 MAC 固定。
#
# qca-nss-dp 只从 DT 取 MAC。板级 DTS 只保留 ethernet0 别名，APPSBL 也只把
# 板级 base MAC 注入 eth0（local-mac-address）；GMAC2..4（eth1..eth3）没有
# MAC，驱动退化为 eth_hw_addr_random()——本地管理位为 1 的随机 MAC，每次
# 启动都变（dmesg: "GMAC2..4 Invalid MAC@ - using …"）。eth1 是 WAN，
# eth2/eth3 组成 br-lan：随机地址让 WAN 的 DHCP 租约和 br-lan 的 MAC、
# fe80:: 链路本地地址每次重启都变。
#
# 这里用 eth0 的稳定 MAC 派生 eth1/eth2/eth3 = 基址 +1/+2/+3（+1 即厂商
# 序列里 WAN 的 …:21），在 netifd 建桥之前写回；eth0 随后被
# eth0-lan-attach 挂进 br-lan，桥的 MAC 自动收敛到数值最小的 eth0，跨重启
# 恒定。
#
# S19：晚于 nss(S15，qca-nss-dp 的装载点)、早于 network(S20，建 br-lan)。
# NSS 档位为 off 时这些 netdev 不存在，脚本安静跳过。
#
# 只在当前 MAC 是随机本地管理 MAC 时才改写：若 bootloader/DT 又给这些口
# 注入全局 MAC，这里自动让位，不做覆盖（但不要把 dp2..dp4 的 ethernetN
# 别名加回来——那正是"三个口同一个 MAC"的来源，见 patches/0045）。

START=19

log() {
	logger -t sbe-lan-mac "$*"
}

# 48 位 MAC 加法：mac_add <aa:bb:cc:dd:ee:ff> <n>
mac_add() {
	local hex v
	hex=$(printf '%s' "$1" | tr -d ':')
	v=$((0x$hex))
	v=$((v + $2))
	printf '%02x:%02x:%02x:%02x:%02x:%02x' \
		$(( (v >> 40) & 255 )) $(( (v >> 32) & 255 )) \
		$(( (v >> 24) & 255 )) $(( (v >> 16) & 255 )) \
		$(( (v >> 8) & 255 )) $(( v & 255 ))
}

pin_one() {
	local dev=$1 want=$2 cur first
	[ -e "/sys/class/net/$dev/address" ] || return 0
	cur=$(cat "/sys/class/net/$dev/address")
	[ "$cur" = "$want" ] && return 0
	first=${cur%%:*}
	if [ $((0x$first & 2)) -ne 2 ]; then
		log "$dev 的 MAC $cur 不是随机本地管理地址，保持不动"
		return 0
	fi
	if ip link set dev "$dev" address "$want"; then
		log "$dev: $cur -> $want"
	else
		log "$dev: 设置 $want 失败（当前 $cur）"
	fi
}

start() {
	local base o1
	if [ ! -e /sys/class/net/eth0/address ]; then
		log "eth0 不存在（NSS dp 未装载），跳过"
		return 0
	fi
	base=$(cat /sys/class/net/eth0/address)
	# base 必须是引导器注入的全局地址；eth0 若随机（ethaddr 缺失），
	# 每次开机都换，不能当 per-unit 基准。
	o1=${base%%:*}
	if [ $((0x$o1 & 2)) -eq 2 ]; then
		log "eth0 的 MAC $base 是随机本地管理地址，跳过"
		return 0
	fi
	pin_one eth1 "$(mac_add "$base" 1)"
	pin_one eth2 "$(mac_add "$base" 2)"
	pin_one eth3 "$(mac_add "$base" 3)"
}

stop() {
	return 0
}
