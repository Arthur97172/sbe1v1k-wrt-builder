#!/bin/sh /etc/rc.common
# 25.12-6.12 NSS 数据通路启动控制器。
#
# 25.12 上 QSDK NSS 栈不再随 kmodloader 自动装载（AUTOLOAD 已移除），也不再
# 由各自的 S16/S18/S19/S26/S72 脚本自动启动（START 已移除）。本脚本在 S15
# 读 /etc/nss.conf 的档位，交给 /usr/sbin/nss-load boot 分层装载：
#   wired（默认）= qca-ssdk + qca-nss-dp，恢复有线管理与网络；
#   full         = wired + qca-nss-ppe 全家 + qca-nss-ecm；
#   off          = 什么都不装载。
# 连续 budget 次启动没等到 commit 时用 fallback 档，避免改档把设备锁进复位
# 循环。详见 docs/NSS_AUTOLOAD_OFF.md。
#
# S15 在 /etc/init.d/boot（S10，调 kmodloader 加载 qca-nss-phy 等）之后、
# netifd（S20）之前，与原来 ssdk(16)/dp(18) 的位置保持一致。

START=15

PROG=/usr/sbin/nss-load

start() {
	[ -x "$PROG" ] || {
		logger -t nss 'nss-load 缺失，跳过 NSS 档位装载'
		return 0
	}
	"$PROG" boot
	return 0
}

stop() {
	# 只停 ECM 与 SFE。rmmod qca-nss-ppe/qca-nss-dp/qca-ssdk 有 ppe_drv_remove
	# oops 风险，要回退请 reboot。
	"$PROG" stop ecm
	"$PROG" stop sfe
	return 0
}
