# 25.12-6.12 诊断变体种子（SBE_VARIANT=diag）— RAM-only 对照实验镜像。
#
# 用途：docs/CONTROL_EXPERIMENT_PLAN-2026-11-16.md 的 D 变体。QSDK NSS/SSDK
# 组件全部保留（用户明确要求），但 /etc/nss.conf 由 files-diag/ 覆盖为
# tier=off：启动时不装载任何 NSS 层，先静置区分「NSS 触发复位」与「其他
# 复位源」，再手工 `nss-load load sdk|dp|ppe|ecm` 逐层定位。
#
# 与生产 seed 的差别：
#   - 不产 squashfs/sysupgrade，只产 initramfs FIT：经 TFTP 直接 RAM 启动，
#     不写 eMMC，断电即恢复原系统；
#   - initramfs 必须 XZ 压缩（kernel 补丁 0031 把 xz 字典提到 128MiB），否则
#     未压缩 cpio 的 FIT 超过 APPSBL 的 tftpboot 32 MiB 上限；
#   - 无 LuCI、无第三方插件、无自维护应用：只留网络、无线、NSS、SSH 和少量
#     取证工具（tcpdump / ethtool / iw），把镜像压到最小。
CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq95xx=y
CONFIG_TARGET_qualcommbe_ipq95xx_DEVICE_spectrum_sbe1v1k=y

# 只要 initramfs。squashfs 与 sysupgrade 镜像对诊断没有用，还会让构建时间
# 翻倍（且本变体永远不写 eMMC）。
CONFIG_TARGET_ROOTFS_INITRAMFS=y
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set

# initramfs 压缩：kernel scripts/Makefile.lib 的 cmd_xzmisc。补丁 0031 把
# `-lzma2=dict=1MiB` 改成 `-9e -lzma2=dict=128MiB`；kernel-defaults.mk 会
# 同时写入 CONFIG_RD_XZ=y。verify-diag.sh 断言 FIT 尺寸与 XZ 载荷。
CONFIG_TARGET_INITRAMFS_COMPRESSION_XZ=y
# CONFIG_TARGET_INITRAMFS_COMPRESSION_NONE is not set

# 主线 PPE 与 QSDK NSS 互斥（设备树删掉了主线 PPE 节点），与生产一致。
# CONFIG_PACKAGE_kmod-qcom-ppe is not set

# W1 — QSDK NSS PPE 数据通路。与生产 seed 同一组件集：诊断镜像必须能在
# 运行时装起完整 NSS 栈，否则对照实验的「逐层装载」无从谈起。
CONFIG_PACKAGE_kmod-qca-nss-ppe-vp=y
CONFIG_PACKAGE_kmod-qca-nss-ppe-rule=y
CONFIG_PACKAGE_kmod-qca-nss-ppe-ds=y
CONFIG_PACKAGE_kmod-qca-nss-ppe-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-ppe-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-ppe-ath-clients=y
CONFIG_PACKAGE_kmod-qca-nss-sfe=y
CONFIG_PACKAGE_kmod-qca-nss-ecm-standard=y
# 生产同款 SSDK 用户态工具（阶段 B）：诊断时也要能读/写端口成员表取证。
CONFIG_PACKAGE_qca-ssdk-shell=y

# 无线：ath12k + 厂商 QCN92XX 固件/BDF。诊断镜像靠三频 SSID（WiFi_2.4G /
# WiFi_5G / WiFi_6G，密钥 12345678，来自 files/ 的 uci-defaults）提供
# SSH 管理面；有线 NSS 起不来时它就是唯一的取数通道。
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-ath12k=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_wpad-mesh-mbedtls=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_sbe-wifi-firmware=y

# 风扇与 RGB（信标用）：PWM 依赖见补丁 0025/0026，KCONFIG 不满足时这些包
# 会被 defconfig 静默丢弃。
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_kmod-leds-pwm=y

# 网络与登录。dropbear 只接受 files-diag/etc/dropbear/authorized_keys 里的
# 公钥（root 没有密码），私钥不进镜像。
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_ip-full=y
# CONFIG_PACKAGE_ip-tiny is not set
CONFIG_PACKAGE_iw-full=y
# CONFIG_PACKAGE_iw is not set

# 取证工具：tcpdump 与 ethtool 在基座树 package/network/utils 里；镜像内
# 抓包后经 SSH 管道回传，是「PHY 载波有、主机零帧」场景下最直接的证据。
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool=y

# 首启默认值包：Allow-SSH-WAN（有线走 eth1 WAN 侧也能管理；LAN 侧本来
# 就放行）、ttyd 关闭（ttyd 未装，脚本自带 guard）。不带 LuCI 相关副作用。
CONFIG_PACKAGE_sbe1v1k-defaults=y

# 与生产一致：LuCI 不装。诊断镜像不需要 Web UI，且 LuCI 的 package hub
# 依赖会显著增大镜像。
# CONFIG_PACKAGE_luci-base is not set
# CONFIG_PACKAGE_luci-light is not set
