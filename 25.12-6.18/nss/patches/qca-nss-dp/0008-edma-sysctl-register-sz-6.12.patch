From: SBE1V1K build <noreply@example.invalid>
Subject: [PATCH] nss-dp: register the EDMA sysctl table with an explicit entry count on 6.11+

Same 6.11 register_sysctl() change as the PPE driver: the macro now uses
ARRAY_SIZE(table), which counts the trailing "{}" terminator, so the
appended NULL-procname entry fails sysctl_check_table() and
registration returns NULL, aborting edma_init_module() with
"sysctl table configuration failed".

Use register_sysctl_sz("net/edma", edma_sub, ARRAY_SIZE(edma_sub) - 1)
on kernel 6.11+ in both the edma_v2 and edma_v3 implementations, and
include linux/version.h for the guard.

Signed-off-by: SBE1V1K build <noreply@example.invalid>
---
diff -ruN a/hal/dp_ops/edma_dp/edma_v2/edma.c b/hal/dp_ops/edma_dp/edma_v2/edma.c
--- a/hal/dp_ops/edma_dp/edma_v2/edma.c	2026-11-17 23:02:59.917941578 +0000
+++ b/hal/dp_ops/edma_dp/edma_v2/edma.c	2026-11-17 23:02:59.962520786 +0000
@@ -5,6 +5,7 @@
  * SPDX-License-Identifier: ISC
  */
 
+#include <linux/version.h>
 #include <linux/module.h>
 #include <linux/debugfs.h>
 #include <linux/interrupt.h>
@@ -1679,7 +1680,15 @@
 	}
 	edma_set_init_stage(EDMA_INIT_STAGE_DESC_MAP_VALID);
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 11, 0)
+	/* 6.11 起 register_sysctl() 取 ARRAY_SIZE(table) 作为条目数，把表尾的
+	 * "{}" 哨兵也算进去；哨兵 procname 为 NULL、无 proc_handler，校验失败
+	 * 导致注册返回 NULL。显式传真实条目数。 */
+	edma_gbl_ctx->ctl_table_hdr = register_sysctl_sz("net/edma", edma_sub,
+			ARRAY_SIZE(edma_sub) - 1);
+#else
 	edma_gbl_ctx->ctl_table_hdr = register_sysctl("net/edma", edma_sub);
+#endif
 	if (!edma_gbl_ctx->ctl_table_hdr) {
 		edma_err("sysctl table configuration failed");
 		kfree(edma_gbl_ctx);
diff -ruN a/hal/dp_ops/edma_dp/edma_v3/edma.c b/hal/dp_ops/edma_dp/edma_v3/edma.c
--- a/hal/dp_ops/edma_dp/edma_v3/edma.c	2026-11-17 23:02:59.935258121 +0000
+++ b/hal/dp_ops/edma_dp/edma_v3/edma.c	2026-11-17 23:02:59.963629540 +0000
@@ -3,6 +3,7 @@
  * SPDX-License-Identifier: ISC
  */
 
+#include <linux/version.h>
 #include <linux/module.h>
 #include <linux/debugfs.h>
 #include <linux/interrupt.h>
@@ -3201,7 +3202,15 @@
 	}
 #endif
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 11, 0)
+	/* 6.11 起 register_sysctl() 取 ARRAY_SIZE(table) 作为条目数，把表尾的
+	 * "{}" 哨兵也算进去；哨兵 procname 为 NULL、无 proc_handler，校验失败
+	 * 导致注册返回 NULL。显式传真实条目数。 */
+	edma_gbl_ctx->ctl_table_hdr = register_sysctl_sz("net/edma", edma_sub,
+			ARRAY_SIZE(edma_sub) - 1);
+#else
 	edma_gbl_ctx->ctl_table_hdr = register_sysctl("net/edma", edma_sub);
+#endif
 	if (!edma_gbl_ctx->ctl_table_hdr) {
 		edma_err("sysctl table configuration failed");
 		return -EINVAL;
