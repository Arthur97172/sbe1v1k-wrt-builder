From: SBE1V1K build <noreply@example.invalid>
Subject: [PATCH] qualcommbe: ipq95xx 增加 Spectrum SBE1V1K NSS 镜像设备

与 askey_sbe1v1k 并列注册 askey_sbe1v1k-nss：同一块板，设备树换用
0031 的 NSS 变体，镜像带 kmod-qca-ssdk-nohnat、kmod-qca-nss-dp、
kmod-qca-nss-ppe 与 qca-ssdk-shell。mainline 设备保留，作为数据通路
已验证的回退镜像，直到 NSS 镜像通过设备测试。

已知副作用（开发期可接受）：两者共用同一份 rootfs 构建，镜像的
DEVICE_PACKAGES 取并集，所以 NSS 包也会进 mainline 镜像；内核仍是
同一个，数据通路由所烧的 DTB 决定，主镜像行为不变。

Status: 构建配置，设备侧 NOT TESTED。
--- a/target/linux/qualcommbe/image/ipq95xx.mk	2026-11-23 02:01:36.661636061 +0000
+++ b/target/linux/qualcommbe/image/ipq95xx.mk	2026-11-23 02:01:49.019683654 +0000
@@ -31,6 +31,27 @@
 endef
 TARGET_DEVICES += askey_sbe1v1k
 
+# Same board, QSDK 14.x NSS data path (S3d).  The board DTS deletes the
+# mainline PPE node and describes ess-switch/EDMA/dp instead, so the image
+# carries the NSS kernel modules; keeping the mainline device above gives a
+# fallback image with the verified data path until the NSS image passes its
+# device tests.
+define Device/askey_sbe1v1k-nss
+	$(call Device/FitImage)
+	$(call Device/EmmcImage)
+	DEVICE_VENDOR := Spectrum
+	DEVICE_MODEL := SBE1V1K
+	DEVICE_VARIANT := NSS
+	DEVICE_DTS := ipq9570-sbe1v1k-nss
+	DEVICE_DTS_CONFIG := config@rtq7300t-rev0
+	KERNEL_LOADADDR := 0x42200000
+	SOC := ipq9570
+	DEVICE_PACKAGES := ath12k-firmware-qcn9274 f2fsck ipq-wifi-askey_sbe1v1k kmod-ath12k \
+		kmod-hwmon-pwmfan kmod-leds-pwm kmod-phy-realtek mkf2fs rtl826x-firmware \
+		kmod-qca-ssdk-nohnat kmod-qca-nss-dp kmod-qca-nss-ppe qca-ssdk-shell
+endef
+TARGET_DEVICES += askey_sbe1v1k-nss
+
 define Device/linksys_ln6001
 	$(call Device/FitImage)
 	DEVICE_VENDOR := Linksys
