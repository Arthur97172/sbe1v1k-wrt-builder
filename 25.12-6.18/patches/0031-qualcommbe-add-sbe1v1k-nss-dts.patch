+		     <0 377 4>,
+		     <0 378 4>,
+		     <0 379 4>,
+		     <0 380 4>,
+		     <0 381 4>,
+		     <0 382 4>,
+		     <0 383 4>,
+		     <0 384 4>,
+		     <0 509 4>,
+		     <0 508 4>,
+		     <0 507 4>,
+		     <0 506 4>,
+		     <0 505 4>,
+		     <0 504 4>,
+		     <0 503 4>,
+		     <0 502 4>,
+		     <0 501 4>,
+		     <0 500 4>,		/* Tx complete ring 31 */
+		     <0 351 4>,		/* Rx desc ring 20 */
+		     <0 352 4>,
+		     <0 353 4>,
+		     <0 354 4>,		/* Rx desc ring 23 */
