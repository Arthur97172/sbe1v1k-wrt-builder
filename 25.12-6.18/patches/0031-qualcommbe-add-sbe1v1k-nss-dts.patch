+		     <0 357 4>,		/* PPEDS 2 Rx fill */
+		     <0 366 4>,		/* PPEDS 3 Tx complete */
+		     <0 334 4>,		/* PPEDS 3 Rx desc */
+		     <0 358 4>;		/* PPEDS 3 Rx fill */
+};
