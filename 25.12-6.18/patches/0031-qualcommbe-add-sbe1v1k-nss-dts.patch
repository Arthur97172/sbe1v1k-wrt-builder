+/*
+ * --- QSDK NSS data path (S3d, 2026-11-23) --------------------------------
+ *
+ * This variant keeps the mainline board description above (WiFi, eMMC, LEDs,
+ * fan, GPIO keys, PCIe, MDIO PHY nodes) and replaces the mainline PPE data
+ * path with the QSDK 14.x NSS stack (qca-ssdk + qca-nss-dp + qca-nss-ppe).
+ *
+ * /delete-node/ &qcom_ppe (top of file) removes the mainline
+ * ethernet@3a000000 node: it owns the same register window (0x3a000000) and
+ * contains a child named "edma" that would shadow qca-nss-dp's
+ * of_find_node_by_name(NULL, "edma") lookup.
+ *
+ * The mainline qca8075_reset_hog on GPIO 60 is not present here: qca-ssdk
+ * drives that reset line itself through "phy-reset-gpio" below.  It only
+ * consumes index 0 (SSDK_PHY_RESET_GPIO_INDEX), so the QCA8075 package reset
+ * (tlmm 60) must come first; tlmm 52 (QCA8081) is declared after it for the
+ * S2 property to stay intact.  The per-PHY reset-gpios above stay owned by
+ * phylib.
+ *
+ * Switch values are from the 6.12 tree (S2: QSDK 14.0 vendor DTB, hardware
+ * validated there): QSGMII for the QCA8075 package, SGMII channel 0 for the
+ * QCA8081, USXGMII for the RTL8261N.
+ *
+ * switch_lan_bmp/switch_wan_bmp do not reach the hardware on this chip: APPE
+ * rewrites every port's member table to all-ones at boot, so the real LAN/WAN
+ * isolation is written at runtime by /usr/sbin/sbe-port-roles (ssdk_sh
+ * portVlan member).  0x38/0x40 are kept for parity with the 6.12 tree.
+ *
+ * qca-ssdk finds the MDIO bus via the "mdio-bus" phandle (its compatible
+ * scan does not match "qcom,ipq9574-mdio","qcom,ipq4019-mdio"), hence the
+ * explicit wiring instead of changing the controller compatible.
+ *
+ * Status: compile tested only, NOT TESTED on hardware.
+ */
+&ess_switch {
+	mdio-bus = <&mdio>;
+
+	switch_lan_bmp = <0x38>;	/* run-time roles come from sbe-port-roles */
+	switch_wan_bmp = <0x40>;
+	/* enum ssdk_port_wrapper_cfg (include/init/ssdk_init.h), one per UNIPHY */
+	switch_mac_mode = <0xb>;	/* uniphy 0: QSGMII (qca8075 package) */
+	switch_mac_mode1 = <0xf>;	/* uniphy 1: SGMII channel 0 (qca8081) */
+	switch_mac_mode2 = <0xd>;	/* uniphy 2: USXGMII (rtl8261n) */
+
+	qcom,port_phyinfo {
+		/* PHYs 16/17 of the package are not wired on this board, so only
+		 * the two used QCA8075 ports are described. */
+		port@0 {
+			port_id = <3>;
+			phy_address = <18>;
+			phy-handle = <&qca8075_18>;
+			phy-mode = "qsgmii";
+		};
+
+		port@1 {
+			port_id = <4>;
+			phy_address = <19>;
+			phy-handle = <&qca8075_19>;
+			phy-mode = "qsgmii";
+		};
+
+		port@2 {
+			port_id = <5>;
+			phy_address = <0x1c>;
+			phy-handle = <&qca8081_28>;
+			phy-mode = "sgmii";
+		};
+
+		port@3 {
+			port_id = <6>;
+			phy_address = <0>;
+			ethernet-phy-ieee802.3-c45;
+			phy-handle = <&rtl8261be_0>;
+			phy-mode = "usxgmii";
+		};
+	};
+};
+
+&mdio {
+	phy-reset-gpio = <&tlmm 60 GPIO_ACTIVE_LOW &tlmm 52 GPIO_ACTIVE_LOW>;
+	clock-frequency = <6250000>;
+};
+
+/*
+ * The UNIPHY register windows are consumed by qca-ssdk (ess-uniphy below).
+ * The mainline PCS drivers must not claim the same registers.
+ */
+&pcs0 {
+	status = "disabled";
+};
+
+&pcs1 {
+	status = "disabled";
+};
+
+&pcs2 {
+	status = "disabled";
+};
+
+&soc {
+	ess-uniphy@7a00000 {
+		compatible = "qcom,ess-uniphy";
+		reg = <0x7a00000 0x30000>;
+		uniphy_access_mode = "local bus";
+	};
+
+	/*
+	 * qca-nss-dp ports.  Probe order is DT order and alloc_etherdev_mqs()
+	 * hands out eth%d sequentially, reproducing the 6.12 ethN mapping:
+	 *   eth0 = dp1 = port 6 = RTL8261N 10G   (LAN, attached outside netifd)
+	 *   eth1 = dp2 = port 5 = QCA8081 2.5G   (WAN by default)
+	 *   eth2 = dp3 = port 3 = qca8075        (LAN)
+	 *   eth3 = dp4 = port 4 = qca8075        (LAN)
+	 *
+	 * phy-mode is deliberately absent: of_get_phy_mode() failing sets
+	 * phylink_en, and ssdk_port_phylink_setup() then takes the interface
+	 * type and phy-handle from qcom,port_phyinfo.
+	 *
+	 * mactype: 0 = qcom_gmac_ops (1G GMAC), 1 = syn_gmac_ops (XGMAC).
+	 * Port 6 is USXGMII, so dp1 gets the XGMAC base 0x3a514000.
+	 */
+	dp1: dp1 {
+		device_type = "network";
+		compatible = "qcom,nss-dp";
+		qcom,id = <6>;
+		reg = <0x3a514000 0x4000>;
+		qcom,mactype = <1>;
+	};
+
+	dp2: dp2 {
+		device_type = "network";
+		compatible = "qcom,nss-dp";
+		qcom,id = <5>;
+		reg = <0x3a001800 0x200>;
+		qcom,mactype = <0>;
+	};
+
+	dp3: dp3 {
+		device_type = "network";
+		compatible = "qcom,nss-dp";
+		qcom,id = <3>;
+		reg = <0x3a001400 0x200>;
+		qcom,mactype = <0>;
+	};
+
+	dp4: dp4 {
+		device_type = "network";
+		compatible = "qcom,nss-dp";
+		qcom,id = <4>;
+		reg = <0x3a001600 0x200>;
+		qcom,mactype = <0>;
+	};
+};
+
+/*
+ * EDMA ring layout, same values as the 6.12 tree (RDP433 reference; ring
+ * ids, queue bases and per-core maps are board independent for IPQ9574).
+ * "qcom,txdesc-map" has one row per port (6) plus one row for the virtual
+ * port; the PPEDS entries are the three Wi-Fi offload nodes.
+ */
+&nss_edma {
+	qcom,txdesc-ring-start = <4>;
+	qcom,txdesc-rings = <28>;
