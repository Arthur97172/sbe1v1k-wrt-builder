#!/bin/sh
#
# 运行期数据通路判别：返回 0 = 本机是 NSS 变体镜像，1 = mainline 镜像。
#
# 两个设备（askey_sbe1v1k 与 askey_sbe1v1k-nss）共用同一份 rootfs 构建，
# DEVICE_PACKAGES 取并集，所以 NSS 的 kmod、脚本、rc.d 链接在 mainline 镜像
# 里也都在。数据通路只由所烧的 DTB 决定：NSS 版设备树（补丁 0031）
# /delete-node/ 了 mainline PPE 节点 soc@0/ethernet@3a000000，mainline 版
# 保留它。这是模块装载之前（board.d 阶段）唯一可靠的判据，NSS 服务启动时
# 也沿用它。
#
# 调用约定：NSS 相关脚本在入口处 `/usr/lib/sbe1v1k/nss-board || exit 0`
# （或 return 0），mainline 镜像上安静退出，不装载 qca-ssdk（它会和 mainline
# PPE 驱动抢 0x3a000000），也不改写 br-lan / board.json。
[ -e /proc/device-tree/soc@0/ethernet@3a000000 ] && exit 1
exit 0
