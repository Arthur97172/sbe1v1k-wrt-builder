#!/bin/sh
#
# 运行期数据通路判别：返回 0 = 本机走 NSS 数据通路，1 = 设备树里仍有
# mainline PPE 节点。
#
# 2026-11-24 起本树只有一个设备（askey_sbe1v1k，补丁 0032 原地把 DTB 切到
# NSS），这份门控不再用于区分两个镜像，只作为运行期安全判据保留：NSS 版
# 设备树（补丁 0031）/delete-node/ 了 mainline PPE 节点
# soc@0/ethernet@3a000000，mainline 版保留它。这是模块装载之前（board.d
# 阶段）唯一可靠的判据，NSS 服务启动时也沿用它。
#
# 调用约定：NSS 相关脚本在入口处 `/usr/lib/sbe1v1k/nss-board || exit 0`
# （或 return 0），门控不满足时安静退出，不装载 qca-ssdk（它会和 mainline
# PPE 驱动抢 0x3a000000），也不改写 br-lan / board.json。
[ -e /proc/device-tree/soc@0/ethernet@3a000000 ] && exit 1
exit 0
