#!/bin/sh
# eth0（uniphy2 / NSS port6，RTL8261N C45 PHY）开机 USXGMII AN 死锁看门狗。
#
# 移植自 25.12-6.12 的同名脚本（2026-11-24）。6.18 上补丁 0040 已消除
# 「复位被 PCS 独占」的确定性缺陷（E4：7 次启动 7 坏 → 3 启 1 坏），但
# XPCS AN 使能 vs RTL8261N 初始化时序竞争仍在，坏启动形态与 6.12 相同：
# AN 永不完成，PHY 铜缆侧照报链路 UP——eth0 看起来「carrier=1」，实际
# 零流量（dmesg 一行 "uniphy autoneg time out!"，0018 的 re-init 也救不
# 回来）。判定特征：uniphy2 的 VR_MII_AN_INTR_STS（0x1f8002）成功启动
# 读回 0x7000（usxg_an_sts=0x70），死锁启动整寄存器为 0x0。
#
# 与 6.12 相同的实测结论：同类寄存器写、XPCS 软复位、PHY 复位+补丁重载
# unbind/bind、铜缆侧重协商、固定速率都无法在死锁启动上把链路救回来，
# 只有再次重启有效。因此做有界自愈：检测到死锁就自动重启一次，用 /etc
# 下的计数器防止重启循环；正常启动时计数器清零，每次坏启动都有一次重试
# 机会。
#
# 只在 NSS 变体上生效：mainline 镜像的 eth0 由 netifd 直接持有，也没有
# ssdk_sh 可读 uniphy 寄存器。nss-board 判据见 /usr/lib/sbe1v1k/nss-board。
#
# 配置：/etc/config/sbe_eth0_watchdog
#   option enabled '1'        # 0 关闭
#   option max_reboots '1'    # 每次启动最多自动重启几次
#
# 判定只在 eth0 有载波时进行：没插线（carrier=0）不能当作 AN 失败。
# ssdk_sh 不可用或读不到寄存器时不做判定。

. /lib/functions.sh

CONF=sbe_eth0_watchdog
COUNT=/etc/sbe-eth0-an-watchdog.count

log() {
	logger -t sbe-eth0-an-watchdog "$*"
}

case "$(board_name 2>/dev/null)" in
askey,sbe1v1k | spectrum,sbe1v1k) ;;
*) exit 0 ;;
esac
/usr/lib/sbe1v1k/nss-board || exit 0
command -v ssdk_sh >/dev/null 2>&1 || exit 0

enabled=$(uci -q get $CONF.main.enabled)
[ -n "$enabled" ] || enabled=1
[ "$enabled" = 1 ] || exit 0

max=$(uci -q get $CONF.main.max_reboots)
case "$max" in
''|*[!0-9]*) max=1 ;;
esac

carrier() {
	cat /sys/class/net/eth0/carrier 2>/dev/null
}

# 等 eth0 出载波：6.18 NSS 变体正常启动在 ~58 s 由 dp 报 link up（ssdk
# 初始化 ~48 s 之后）。最多等 150 s，没载波说明没插线（或该变体没有
# eth0），直接结束，不判死。
i=0
while [ "$i" -lt 30 ]; do
	[ "$(carrier)" = 1 ] && break
	sleep 5
	i=$((i+1))
done
if [ "$(carrier)" != 1 ]; then
	log "eth0 无载波，跳过检测"
	echo 0 > "$COUNT"
	exit 0
fi

# 读 uniphy2 VR_MII_AN_INTR_STS（0x1f8002）并判断 USXGMII AN 是否完成：
# usxg_an_sts 是 bit8-14，成功启动恒为非 0（0x70），死锁启动为 0。
an_ok() {
	st=$(ssdk_sh debug uniphy get 2 0x1f8002 4 </dev/null 2>/dev/null |
		sed -n 's/.*\[Data\]:0x\([0-9a-fA-F]\{1,\}\).*/0x\1/p' | head -n1)
	[ -n "$st" ] || return 0	# 读不到就不判死
	[ $((st & 0x7f00)) -ne 0 ]
}

# dp 报 link up 后至少等一个 100 ms 等待周期再采样；三次采样跨 17 s，
# 排除 AN 在边沿之后才完成的正常竞态（6.18 坏启动的 AN 判定在 link up
# 后 100 ms~4 s 之间完成，好启动更早）。
sleep 3
if an_ok; then
	echo 0 > "$COUNT"
	exit 0
fi
sleep 8
if an_ok; then
	echo 0 > "$COUNT"
	exit 0
fi
sleep 6
if an_ok; then
	echo 0 > "$COUNT"
	exit 0
fi

n=$(cat "$COUNT" 2>/dev/null)
case "$n" in
''|*[!0-9]*) n=0 ;;
esac
if [ "$n" -ge "$max" ]; then
	log "eth0 USXGMII AN 未完成，已自动重启 $n 次，放弃本轮（端口保持假链路）"
	exit 0
fi

echo $((n+1)) > "$COUNT"
sync
log "eth0 USXGMII AN 未完成（VR_MII_AN_INTR_STS=0x0），自动重启 $((n+1))/$max"
sleep 2
reboot
