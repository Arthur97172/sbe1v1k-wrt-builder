# 仓库只保存编译输入：24.10-6.6/、25.12-6.12/ 与对应的 workflow。
# 以下内容只在本机存在，不进 git。

# 装配源码树与构建产物（约 24 GB）
/sources/
/dist/
/firmware/
/extracted/
/logs/
/build/

# 本机审计与测试资料
/scripts/
/docs/
/files/
/banner
/99-wireless-defaults
/README.md
/CLAUDE.md
/CLAUDE_BUILD_GUIDE.md
/.claude/

# 宿主机垫片软链由脚本按清单重建（本机指向 /usr/bin/gnu*，runner 上没有）
/24.10-6.6/build/host-bin/
/25.12-6.12/build/host-bin/

# 第三方插件的解析缓存（fetch-plugins.sh 的 blobless 元数据克隆与打包树）。
# 只影响本机构建速度，CI 每次从零建；不得入库。
/.sbe-cache/

# Stage 2.5：厂商 Wi-Fi 固件 blob **入库**（2026-10-24 决定）。
# 授权状态仍是 LICENSE_REVIEW_REQUIRED；用户明确接受公开分发风险，
# 目的是让公开 CI 产出带无线固件的镜像。Makefile / FILES-SHA256 /
# LICENSE-STATUS 与 blob 一并入库，构建时由 Build/Prepare 校验哈希。
# 若要回到“不入库”，恢复下面一行即可（CI 随后会因缺 blob 失败）：
# /25.12-6.12/build/local-packages/sbe-wifi-firmware/files/**/*.bin

# 签名材料与备份
key-build
key-build.*
*.ucert
*.bak
*.log
