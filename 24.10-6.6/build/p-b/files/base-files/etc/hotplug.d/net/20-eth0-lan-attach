#!/bin/sh
#
# 内核 netdev 事件兜底：br-lan 新建/变化、或 eth0 重新出现时补挂一次。主触发点
# 是 hotplug.d/iface；这里只覆盖没有 iface 事件的路径（也覆盖 netifd 重启）。

case "$ACTION" in
add | change) ;;
*) exit 0 ;;
esac
case "$INTERFACE" in
br-lan | eth0) ;;
*) exit 0 ;;
esac
[ -x /usr/sbin/eth0-lan-attach ] && ( /usr/sbin/eth0-lan-attach attach >/dev/null 2>&1 & )
exit 0
