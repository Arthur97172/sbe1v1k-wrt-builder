# P-B staging copy.  Base: sources/codelinaro/oss-system-feeds-target-ipq/
# ipq95xx/base-files/etc/board.d/01_network (feed revision, not the older
# vendor S1 copy).  Only the "spectrum,sbe1v1k" branch is added; it is copied
# from the vendor rootfs (extracted/rootfs/etc/board.d/01_network) so that the
# interface topology of the first P-B image reproduces the shipped one.

[ -e /etc/config/network ] && exit 0

touch /etc/config/network

CFG=/etc/board.json

. /lib/functions/uci-defaults.sh

ipq95xx_setup_interfaces()
{
	local board="$1"

	case "$board" in
	spectrum,sbe1v1k)
		# Vendor topology (evidence: extracted/rootfs/etc/board.d/01_network).
		# eth0 is attached to br-lan by eth0-lan-attach so a LAN address
		# reload cannot reset RTL8261N/dp1.
		#   eth0 / PPE port 6 / RTL8261N 10G -> unmanaged LAN bridge port
		#   eth1 / PPE port 5 / QCA8081 2.5G -> WAN
		#
		# eth0 is listed here so /etc/board.json advertises it and LuCI's
		# port-status page shows all four ports.  netifd must not own it,
		# so 99-spectrum-eth0-unmanaged-lan (uci-defaults, runs after
		# config_generate) strips it back out of the generated br-lan ports.
		ucidef_set_interfaces_lan_wan "eth2 eth3 eth0" "eth1"
		;;
	qcom,ipq9574-ap-al01-c1 |\
	qcom,ipq9574-ap-al02-c1 |\
	qcom,ipq9574-ap-al02-c2 |\
	qcom,ipq9574-ap-al02-c3 |\
	qcom,ipq9574-ap-al02-c4 |\
	qcom,ipq9574-ap-al02-c5 |\
	qcom,ipq9574-ap-al02-c6 |\
	qcom,ipq9574-ap-al02-c7 |\
	qcom,ipq9574-ap-al02-c8 |\
	qcom,ipq9574-ap-al02-c11 |\
	qcom,ipq9574-ap-al02-c12 |\
	qcom,ipq9574-ap-al02-c13 |\
	qcom,ipq9574-ap-al02-c14 |\
	qcom,ipq9574-ap-al02-c15 |\
	qcom,ipq9574-ap-al02-c16 |\
	qcom,ipq9574-ap-al02-c17 |\
	qcom,ipq9574-ap-al02-c18 |\
	qcom,ipq9574-ap-al02-c19 |\
	qcom,ipq9574-ap-al02-c20 |\
	qcom,ipq9574-ap-al05 |\
	qcom,ipq9574-ap-al05-qca81xx |\
	qcom,ipq9574-ap-al05-qca81xx-i2c |\
	qcom,ipq9574-ap-al05-qce1204 |\
	qcom,ipq9574-ap-al02-c8-qce1204 |\
	qcom,ipq9574-ap-al06 |\
	qcom,ipq9574-db-al01-c1 |\
	qcom,ipq9574-db-al01-c2 |\
	qcom,ipq9574-db-al01-c3 |\
	qcom,ipq9574-db-al02-c1 |\
	qcom,ipq9574-db-al02-c2 |\
	qcom,ipq9574-db-al02-c3)
		ucidef_set_interfaces_lan_wan "eth1 eth2 eth3 eth4 eth5" "eth0"
		;;
	qcom,ipq9574-ap-al02-c9 |\
	qcom,ipq9574-ap-al03-c1 |\
	qcom,ipq9574-ap-al03-c2)
		ucidef_set_interfaces_lan_wan "eth1 eth2 eth3 eth4" "eth0"
		;;
	qcom,ipq9574-ap-al02-c10)
		ucidef_set_interfaces_lan_wan "eth1 eth2" "eth0"
		ucidef_add_switch "switch1"
		ucidef_add_switch_attr "switch1" "enable" false
		;;
	*)
		echo "Unsupported hardware. Network interfaces not intialized"
		;;
	esac
}

board_config_update
board=$(board_name)
ipq95xx_setup_interfaces $board
board_config_flush

exit 0
