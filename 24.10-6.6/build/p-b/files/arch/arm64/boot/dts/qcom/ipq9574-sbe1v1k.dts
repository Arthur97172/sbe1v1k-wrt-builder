/*
 * Spectrum SBE1V1K (Askey) - IPQ9574 + 3 x QCN9224
 *
 * STAGED DRAFT.  This file has NOT been applied to sources/, has never been
 * built with make, and has never been booted.  It exists so the device
 * definition can be reviewed before the build stage is approved.
 *
 * Evidence tags used below:
 *   RD = arch/arm64/boot/dts/qcom/ipq9574-rdp433.dts
 *        (oss-kernel-linux-ipq-files, the reference board for this target)
 *   DS = ipq9574.dtsi / ipq9574-qcn9224-default-memory.dtsi
 *   S1 = Spectrum product DTB extracted from the vendor firmware (QSDK 13,
 *        Linux 6.6.47) - extracted/kernel/sbe1v1k.dtb
 *   S2 = Askey QSDK-14 DTB extracted from the reference firmware
 *        (Linux 6.6.116, this ath12k generation) -
 *        extracted/qsdk14/sbe1v1k-askey.dtb
 *   NET = base-files/etc/board.d/01_network from the vendor rootfs
 *
 * See docs/PB_DEVICE_DEFINITION.md for the per-value evidence table and for
 * the list of values that remain UNVERIFIED.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "ipq9574.dtsi"
#include "ipq9574-qcn9224-default-memory.dtsi"

/ {
	/* S1: "Spectrum SBE1V1K ( Wi-Fi 7 320MHZ )"; shortened, no changed meaning */
	model = "Spectrum SBE1V1K";

	/*
	 * The first string is what /lib/preinit/02_sysinfo writes to
	 * /tmp/sysinfo/board_name (strings /proc/device-tree/compatible | head -1),
	 * and every board.d branch in the vendor rootfs keys on it (S1, NET).
	 */
	compatible = "spectrum,sbe1v1k", "qcom,ipq9574-ap-al02-c4",
		     "qcom,ipq9574-al02", "qcom,ipq9574";

	aliases {
		/* Console.  DS defines serial0..2 nowhere; RD does it this way. */
		serial0 = &blsp1_uart2;

		/*
		 * Documentation only: nss_dp_main.c never calls of_alias_get_id(),
		 * so ethN are assigned by DT probe order (see the dp nodes below).
		 * RD's "/soc/dpN" strings no longer resolve (the node is soc@0).
		 */
		ethernet0 = &dp1;	/* 10G   RTL8261N  */
		ethernet1 = &dp2;	/* 2.5G  QCA8081   */
		ethernet2 = &dp3;	/* 1G    qca8075   */
		ethernet3 = &dp4;	/* 1G    qca8075   */
	};

	chosen {
		stdout-path = "serial0:115200n8";

		/*
		 * S1 carries the same option.  S1 also appends
		 * "cnss2.enable_mlo_support=1", which only applies to the qcawifi
		 * stack and is deliberately not carried over.
		 *
		 * RD's "pcie_pme=nomsi" is NOT copied: the vendor product DTB (S1)
		 * does not set it, so it is not part of this board's boot contract.
		 */
		bootargs-append = " fstools_ignore_partname=1";
	};
};

/*
 * ---------------------------------------------------------------------------
 * Reserved memory
 * ---------------------------------------------------------------------------
 */

/*
 * DS emits nss@40000000 only under #if defined(__IPQ_PROFILE_MINENT__), which
 * no target in this tree defines.  S1 proves the vendor reserves it and the
 * NSS firmware requires it.  32 MB at 0x40000000..0x42000000 is the reason
 * Device/spectrum_sbe1v1k must set KERNEL_LOADADDR := 0x42000000; the target's
 * Device/Default falls back to 0x40000000 because CONFIG_ENABLE_UBI_CORE is
 * not a defined symbol anywhere.
 */
&{/reserved-memory} {
	nss@40000000 {
		no-map;
		reg = <0x0 0x40000000 0x0 0x2000000>;
		status = "okay";
	};

	/*
	 * DS ships three 36 MB windows whose node names encode the default base
	 * addresses.  S2 (the same board, same driver generation) uses 64 MB
	 * windows at 0x50100000 / 0x54100000 / 0x58100000 but left the node unit
	 * addresses at the old values.  The nodes are deleted and redeclared so
	 * the unit address matches reg.
	 *
	 * Why the region base and size are what matters, and the cnss-node
	 * base-addr/caldb-addr properties are not: ath12k looks the region up by
	 * name ("host-ddr-mem", ath12k/core.c: ath12k_core_get_reserved_mem_by_name)
	 * and then lays out every firmware chunk sequentially from its base
	 * (ath12k/qmi.c: ab->qmi.target_mem[idx].paddr = ddr_rmem->base + sz).
	 * Nothing in ath12k reads base-addr / hremote-size.
	 */
	/delete-node/ qcn9224_pcie1@50100000;
	/delete-node/ qcn9224_pcie2@52500000;
	/delete-node/ qcn9224_pcie3@54900000;

	qcn9224_pcie1: qcn9224_pcie1@50100000 {
		no-map;
		reg = <0x0 0x50100000 0x0 0x4000000>;
		status = "okay";
	};

	qcn9224_pcie2: qcn9224_pcie2@54100000 {
		no-map;
		reg = <0x0 0x54100000 0x0 0x4000000>;
		status = "okay";
	};

	qcn9224_pcie3: qcn9224_pcie3@58100000 {
		no-map;
		reg = <0x0 0x58100000 0x0 0x4000000>;
		status = "okay";
	};
};

/*
 * mhi_region1..3 stay disabled, exactly as in RD and S2: RD only enables them
 * under __MHI_BUS_RESERVED_DMA_POOL__, a macro no build in this tree defines.
 */

/* S2 and RD both enable this one. */
&mlo_global_mem0 {
	status = "okay";
};

/*
 * ---------------------------------------------------------------------------
 * Console
 * ---------------------------------------------------------------------------
 */

&blsp1_uart2 {
	pinctrl-0 = <&uart2_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/*
 * ---------------------------------------------------------------------------
 * Ethernet: MDIO, PHYs, switch, nss-dp
 * ---------------------------------------------------------------------------
 */

/* S1: two reset lines, tlmm 60 (qca8075) and tlmm 52 (RTL8261N). */
&mdio {
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	phy-reset-gpio = <&tlmm 60 GPIO_ACTIVE_LOW &tlmm 52 GPIO_ACTIVE_LOW>;
	status = "okay";

	ethernet-phy-package@0 {
		compatible = "qcom,qca8075-package";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x10>;
		qcom,package-mode = "qsgmii";

		sw_phy0: ethernet-phy@10 {
			reg = <0x10>;
		};

		sw_phy1: ethernet-phy@11 {
			reg = <0x11>;
		};

		sw_phy2: ethernet-phy@12 {
			reg = <0x12>;
		};

		sw_phy3: ethernet-phy@13 {
			reg = <0x13>;
		};
	};

	/* QCA8081 2.5G, S1 reg 0x1c */
	sw_phy4: ethernet-phy@1c {
		reg = <0x1c>;
	};

	/* RTL8261N 10G, C45, S1 reg 0x00 */
	sw_phy5: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0x0>;
	};
};

&ess_switch {
	switch_cpu_bmp = <0x1>;
	switch_inner_bmp = <0x80>;
	/* S1/NET: port 5 is WAN; ports 3, 4 and 6 are LAN (0x58 = BIT(3)|BIT(4)|BIT(6)) */
	switch_lan_bmp = <0x58>;
	switch_wan_bmp = <0x20>;
	/* S1: QSGMII / SGMII_CHANNEL0 / USXGMII */
	switch_mac_mode = <0x0b>;
	switch_mac_mode1 = <0x0f>;
	switch_mac_mode2 = <0x0d>;
	bm_tick_mode = <0>;
	tm_tick_mode = <0>;

	qcom,port_phyinfo {
		port@0 {
			port_id = <1>;
			phy_address = <0x10>;
			phy-handle = <&sw_phy0>;
			phy-mode = "qsgmii";
		};

		port@1 {
			port_id = <2>;
			phy_address = <0x11>;
			phy-handle = <&sw_phy1>;
			phy-mode = "qsgmii";
		};

		port@2 {
			port_id = <3>;
			phy_address = <0x12>;
			phy-handle = <&sw_phy2>;
			phy-mode = "qsgmii";
		};

		port@3 {
			port_id = <4>;
			phy_address = <0x13>;
			phy-handle = <&sw_phy3>;
			phy-mode = "qsgmii";
		};

		port@4 {
			port_id = <5>;
			phy_address = <0x1c>;
			phy-handle = <&sw_phy4>;
			phy-mode = "sgmii";
			port_mac_sel = "QGMAC_PORT";
		};

		port@5 {
			port_id = <6>;
			phy_address = <0x0>;
			phy-handle = <&sw_phy5>;
			phy-mode = "usxgmii";
			ethernet-phy-ieee802.3-c45;
		};
	};

	/* S1: QCA8081 LED sources for port 5; parsed by ssdk_dt_parse_port_ledinfo */
	qcom,port_ledinfo {
		port5 {
			port = <5>;

			led_source@f {
				source = <0xf>;
				mode = "normal";
				speed = "all";
				blink_en = "enable";
				freq = "auto";
				active = "low";
			};

			led_source@10 {
				source = <0x10>;
				mode = "normal";
				speed = "all";
				blink_en = "enable";
				freq = "auto";
				active = "low";
			};
		};
	};
};

/*
 * nss-dp probe order defines ethN: probe order is DT order, and
 * alloc_etherdev_mqs() hands out eth%d sequentially (nss_dp_main.c:1133).
 * The order below reproduces the vendor mapping recorded in NET:
 *   eth0 = dp1 = port 6 = RTL8261N 10G   (attached to br-lan by eth0-lan-attach)
 *   eth1 = dp2 = port 5 = QCA8081 2.5G   (wan)
 *   eth2 = dp3 = port 3 = qca8075        (lan)
 *   eth3 = dp4 = port 4 = qca8075        (lan)
 *
 * phy-mode is deliberately absent on every dp node.  of_get_phy_mode() fails,
 * which sets phylink_en = true (nss_dp_main.c:891 -- the sense of that branch
 * is inverted relative to a normal success check), and ssdk_port_phylink_setup()
 * then takes the interface type and phy-handle from qcom,port_phyinfo above.
 * This is RD's arrangement.  S1 instead put phy-mode/qcom,phy-mdio-addr on the
 * dp nodes, which selects the legacy phy_connect() path in a driver generation
 * this build does not use.
 *
 * mactype: 0 = qcom_gmac_ops (1G GMAC), 1 = syn_gmac_ops (Synopsys XGMAC).
 * For ipq95xx only hal/gmac_ops/qcom/qcom_if.o and hal/gmac_ops/syn/xgmac/syn_if.o
 * are linked (oss-lklm-nss-dp/Makefile), and nss_ipq95xx.c registers exactly
 * those two types.  Port 6 is USXGMII and therefore needs the XGMAC base
 * (0x3a514000) with mactype 1.  S2 -- the QSDK-14 build for this same board,
 * i.e. the driver generation this tree uses -- pairs dp1 id 6 / 0x3a514000 with
 * mactype 1.  S1 pairs that base with mactype 0, which is an artifact of its
 * older driver.  RD has no XGMAC port (its dp1 is port 1 at 0x3a001000,
 * mactype 0), so it is not evidence either way for port 6.
 *
 * qcom,ppe-offload-disabled is deliberately NOT copied from RD's dp1..dp4:
 * NSS/PPE offload is a requirement for this build.
 */
&soc {
	dp1: dp1 {
		device_type = "network";
		compatible = "qcom,nss-dp";
		qcom,id = <6>;
		reg = <0x3a514000 0x4000>;
		qcom,mactype = <1>;
		local-mac-address = [00 00 00 00 00 00];
	};

	dp2: dp2 {
		device_type = "network";
		compatible = "qcom,nss-dp";
		qcom,id = <5>;
		reg = <0x3a001800 0x200>;
		qcom,mactype = <0>;
		local-mac-address = [00 00 00 00 00 00];
	};

	dp3: dp3 {
		device_type = "network";
		compatible = "qcom,nss-dp";
		qcom,id = <3>;
		reg = <0x3a001400 0x200>;
		qcom,mactype = <0>;
		local-mac-address = [00 00 00 00 00 00];
	};

	dp4: dp4 {
		device_type = "network";
		compatible = "qcom,nss-dp";
		qcom,id = <4>;
		reg = <0x3a001600 0x200>;
		qcom,mactype = <0>;
		local-mac-address = [00 00 00 00 00 00];
	};

	/*
	 * EDMA host-driver ring configuration.  RD433, S1 and S2 carry this
	 * block with identical values (the interrupts arrays are element-for-
	 * element equal), and it is mandatory rather than tuning:
	 * qca-nss-dp's edma_v2 probe does of_property_read_u32() on
	 * qcom,txdesc-ring-start and the rest of the ring map
	 * (hal/dp_ops/edma_dp/edma_v2/edma.c:569) and returns -EINVAL when any
	 * is absent, and edma_irq_init() platform_get_irq()s one IRQ per
	 * txcmpl / rxdesc / rxfill ring plus misc, returning -1 on a shortfall.
	 * Without this node qca-nss-dp never binds and no Ethernet port ever
	 * appears (the v22 failure).  compatible/reg/resets/clocks stay as
	 * declared in ipq9574.dtsi; only the properties below are added.
	 */
	edma@3ab00000 {
		qcom,txdesc-ring-start = <4>;		/* Tx desc ring start ID */
		qcom,txdesc-rings = <28>;		/* Total number of Tx desc rings to be provisioned */
		qcom,txcmpl-ring-start = <4>;		/* Tx complete ring start ID */
		qcom,txcmpl-rings = <28>;		/* Total number of Tx complete rings to be provisioned */
		qcom,rxfill-ring-start = <4>;		/* Rx fill ring start ID */
		qcom,rxfill-rings = <4>;		/* Total number of Rx fill rings to be provisioned */
		qcom,rxdesc-ring-start = <20>;		/* Rx desc ring start ID */
		qcom,rxdesc-rings = <4>;		/* Total number of Rx desc rings to be provisioned */
		qcom,rx-page-mode = <0>;		/* Rx fill ring page mode */
		qcom,tx-map-priority-level = <1>;	/* Tx priority level per port */
		qcom,rx-map-priority-level = <1>;	/* Rx priority level per core */
		qcom,ppeds-num = <3>;			/* Number of PPEDS nodes */
		/* PPE-DS node format: <Rx-fill Tx-cmpl Rx Tx Queue-base Queue-count> */
		qcom,ppeds-map = <1 1 1 1 32 8>,	/* PPEDS Node#0 ring and queue map */
				 <2 2 2 2 40 8>,	/* PPEDS Node#1 ring and queue map */
				 <3 3 3 3 48 8>;	/* PPEDS Node#2 ring and queue map */
		qcom,txdesc-map = <8 9 10 11>,		/* Port0 per-core Tx ring map */
				  <12 13 14 15>,	/* Port1 per-core Tx ring map */
				  <16 17 18 19>,	/* Port2 per-core Tx ring map */
				  <20 21 22 23>,	/* Port3 per-core Tx ring map */
				  <24 25 26 27>,	/* Port4 per-core Tx ring map */
				  <28 29 30 31>,	/* Port5 per-core Tx ring map */
				  <4 5 6 7>;		/* Used only for packets from VP */
		qcom,txdesc-fc-grp-map = <1 2 3 4 5 6>;	/* Per GMAC flow control group map */
		qcom,rxfill-map = <4 5 6 7>;		/* Per-core Rx fill ring map */
		qcom,rxdesc-map = <20 21 22 23>;	/* Per-core Rx desc ring map */
		qcom,rx-queue-start = <0>;		/* Rx queue start */
		qcom,rx-ring-queue-map = <0 8 16 24>,	/* Priority 0 queues per-core Rx ring map */
					 <1 9 17 25>,	/* Priority 1 queues per-core Rx ring map */
					 <2 10 18 26>,	/* Priority 2 queues per-core Rx ring map */
					 <3 11 19 27>,	/* Priority 3 queues per-core Rx ring map */
					 <4 12 20 28>,	/* Priority 4 queues per-core Rx ring map */
					 <5 13 21 29>,	/* Priority 5 queues per-core Rx ring map */
					 <6 14 22 30>,	/* Priority 6 queues per-core Rx ring map */
					 <7 15 23 31>;	/* Priority 7 queues per-core Rx ring map */
		qcom,vp-id = <8>;			/* Virtual port dummy MAC Id */
		qcom,txdesc_point_offload_ring = <0>;	/* Txdesc point offload ring */
		qcom,txcmpl_point_offload_ring = <0>;	/* Txcmpl point offload ring */
		qcom,rxfill_point_offload_ring = <0>;	/* Rxfill point offload ring */
		qcom,rxdesc_point_offload_ring = <0>;	/* Rxdesc point offload ring */
		qcom,num_loopback_rings = <1>;
		qcom,txdesc_loopback_ring_id = <0>;
		qcom,txcmpl_loopback_ring_id = <0>;
		qcom,rxfill_loopback_ring_id = <0>;
		qcom,rxdesc_loopback_ring_id = <0>;
		qcom,loopback_queue_base = <56>;
		qcom,loopback_num_queues = <8>;
		interrupts = <0 367 4>,			/* Tx complete ring id #4 IRQ info */
			     <0 368 4>,			/* Tx complete ring id #5 IRQ info */
			     <0 369 4>,			/* Tx complete ring id #6 IRQ info */
			     <0 370 4>,			/* Tx complete ring id #7 IRQ info */
			     <0 371 4>,			/* Tx complete ring id #8 IRQ info */
			     <0 372 4>,			/* Tx complete ring id #9 IRQ info */
			     <0 373 4>,			/* Tx complete ring id #10 IRQ info */
			     <0 374 4>,			/* Tx complete ring id #11 IRQ info */
			     <0 375 4>,			/* Tx complete ring id #12 IRQ info */
			     <0 376 4>,			/* Tx complete ring id #13 IRQ info */
			     <0 377 4>,			/* Tx complete ring id #14 IRQ info */
			     <0 378 4>,			/* Tx complete ring id #15 IRQ info */
			     <0 379 4>,			/* Tx complete ring id #16 IRQ info */
			     <0 380 4>,			/* Tx complete ring id #17 IRQ info */
			     <0 381 4>,			/* Tx complete ring id #18 IRQ info */
			     <0 382 4>,			/* Tx complete ring id #19 IRQ info */
			     <0 383 4>,			/* Tx complete ring id #20 IRQ info */
			     <0 384 4>,			/* Tx complete ring id #21 IRQ info */
			     <0 509 4>,			/* Tx complete ring id #22 IRQ info */
			     <0 508 4>,			/* Tx complete ring id #23 IRQ info */
			     <0 507 4>,			/* Tx complete ring id #24 IRQ info */
			     <0 506 4>,			/* Tx complete ring id #25 IRQ info */
			     <0 505 4>,			/* Tx complete ring id #26 IRQ info */
			     <0 504 4>,			/* Tx complete ring id #27 IRQ info */
			     <0 503 4>,			/* Tx complete ring id #28 IRQ info */
			     <0 502 4>,			/* Tx complete ring id #29 IRQ info */
			     <0 501 4>,			/* Tx complete ring id #30 IRQ info */
			     <0 500 4>,			/* Tx complete ring id #31 IRQ info */
			     <0 351 4>,			/* Rx desc ring id #20 IRQ info */
			     <0 352 4>,			/* Rx desc ring id #21 IRQ info */
			     <0 353 4>,			/* Rx desc ring id #22 IRQ info */
			     <0 354 4>,			/* Rx desc ring id #23 IRQ info */
			     <0 499 4>,			/* Misc error IRQ info */
			     <0 359 4>,			/* RxFill ring id #4 IRQ info */
			     <0 360 4>,			/* RxFill ring id #5 IRQ info */
			     <0 361 4>,			/* RxFill ring id #6 IRQ info */
			     <0 362 4>,			/* RxFill ring id #7 IRQ info */
			     <0 364 4>,			/* PPEDS Node #1(TxComp ring id #1) TxComplete IRQ info */
			     <0 332 4>,			/* PPEDS Node #1(Rx Desc ring id #1) Rx Desc IRQ info */
			     <0 356 4>,			/* PPEDS Node #1(RxFill Desc ring id #1) Rx Fill IRQ info */
			     <0 365 4>,			/* PPEDS Node #2(TxComp ring id #2) TxComplete IRQ info */
			     <0 333 4>,			/* PPEDS Node #2(Rx Desc ring id #2) Rx Desc IRQ info */
			     <0 357 4>,			/* PPEDS Node #2(RxFill Desc ring id #2) Rx Fill IRQ info */
			     <0 366 4>,			/* PPEDS Node #3(TxComp ring id #3) TxComplete IRQ info */
			     <0 334 4>,			/* PPEDS Node #3(Rx Desc ring id #3) Rx Desc IRQ info */
			     <0 358 4>;			/* PPEDS Node #3(RxFill Desc ring id #3) Rx Fill IRQ info */
	};
};

/*
 * ---------------------------------------------------------------------------
 * PCIe / Wi-Fi: three QCN9224 behind the WSI ring
 * ---------------------------------------------------------------------------
 */

&pcie1_phy {
	status = "okay";
};

&pcie2_phy {
	status = "okay";
};

&pcie3_phy {
	status = "okay";
};

/* RD and S2 carry identical chip_info */
&wsi {
	id = <0>;
	num_chip = <3>;
	status = "okay";
	chip_info = <0 2 1 2>,
		    <1 2 2 0>,
		    <2 2 0 1>;
};

/*
 * The wifi@0 property sets below are S2's, and S2's board_id/caldata_offset
 * values are identical to RD's, which is independent confirmation that they
 * describe this hardware and not a reference board:
 *   pcie1 -> wifi5, board_id 1, wsi_index 2, caldata 0x58800
 *   pcie2 -> wifi6, board_id 4, wsi_index 0, caldata 0x8a800 (WSI controller)
 *   pcie3 -> wifi7, board_id 2, wsi_index 1, caldata 0xbc800
 * qcom,caldata_offset is consumed by U-Boot's fdt_fixup
 * (oss-boot-u-boot/board/qti/common/fdt_fixup.c:410), not by the kernel.
 *
 * qcom,early_cal_enabled = "disabled" on all three follows S2.  RD marks the
 * second and third controllers "supported"; S2 is the same board, so S2 wins.
 *
 * The memory-region phandles point at mhi_regionN even though those pools stay
 * disabled -- S2 and RD both do this; ath12k only resolves host-ddr-mem and
 * mlo-global-mem by name.
 */

&pcie1_x1 {
	perst-gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie@0 {
		device_type = "pci";
		reg = <0x0 0x0 0x0 0x0 0x0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi@0 {
			boot-args = <0x2 0x4 0x34 0x3 0x0 0x0
				     0x4 0x4 0x18 0x3 0x0 0x0
				     0x0 0x4 0x0 0x0 0x0 0x0>;
			memory-region = <&qcn9224_pcie1>, <&mhi_region1>, <&mlo_global_mem0>;
			memory-region-names = "host-ddr-mem", "mhi-region", "mlo-global-mem";
			reg = <0x0 0x0 0x0 0x0 0x0>;
			qcom,early_cal_enabled = "disabled";
			qcom,caldata_offset = <0x58800>;
			qcom,caldb_offset = <0x1100000>;
			qcom,caldb_size = <0x800000>;
			qcom,board_id = <0x01>;
			qcom,wsi = <&wsi>;
			qcom,wsi_index = <2>;
			qcom,pta-num = <0>;
			qcom,coex-mode = <0x2>;
			qcom,bt-active-time = <0x18>;
			qcom,bt-priority-time = <0x12>;
			qcom,coex-algo = <0x2>;
			qcom,pta-priority = <0x80800505>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					wifi1_wsi_tx: endpoint {
						remote-endpoint = <&wifi2_wsi_rx>;
					};
				};

				port@1 {
					reg = <1>;

					wifi1_wsi_rx: endpoint {
						remote-endpoint = <&wifi3_wsi_tx>;
					};
				};
			};
		};
	};
};

&pcie2_x2 {
	perst-gpios = <&tlmm 29 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie@0 {
		device_type = "pci";
		reg = <0x0 0x0 0x0 0x0 0x0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi@0 {
			boot-args = <0x2 0x4 0x34 0x3 0x0 0x0
				     0x4 0x4 0x18 0x3 0x0 0x0
				     0x0 0x4 0x0 0x0 0x0 0x0>;
			memory-region = <&qcn9224_pcie2>, <&mhi_region2>, <&mlo_global_mem0>;
			memory-region-names = "host-ddr-mem", "mhi-region", "mlo-global-mem";
			reg = <0x0 0x0 0x0 0x0 0x0>;
			qcom,early_cal_enabled = "disabled";
			qcom,caldata_offset = <0x8a800>;
			qcom,caldb_offset = <0x1100000>;
			qcom,caldb_size = <0x800000>;
			qcom,board_id = <0x04>;
			qcom,wsi = <&wsi>;
			qcom,wsi_index = <0>;
			qcom,wsi-controller;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					wifi2_wsi_tx: endpoint {
						remote-endpoint = <&wifi3_wsi_rx>;
					};
				};

				port@1 {
					reg = <1>;

					wifi2_wsi_rx: endpoint {
						remote-endpoint = <&wifi1_wsi_tx>;
					};
				};
			};
		};
	};
};

&pcie3_x2 {
	perst-gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie@0 {
		device_type = "pci";
		reg = <0x0 0x0 0x0 0x0 0x0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi@0 {
			boot-args = <0x2 0x4 0x34 0x3 0x0 0x0
				     0x4 0x4 0x18 0x3 0x0 0x0
				     0x0 0x4 0x0 0x0 0x0 0x0>;
			memory-region = <&qcn9224_pcie3>, <&mhi_region3>, <&mlo_global_mem0>;
			memory-region-names = "host-ddr-mem", "mhi-region", "mlo-global-mem";
			reg = <0x0 0x0 0x0 0x0 0x0>;
			qcom,early_cal_enabled = "disabled";
			qcom,caldata_offset = <0xbc800>;
			qcom,caldb_offset = <0x1100000>;
			qcom,caldb_size = <0x800000>;
			qcom,board_id = <0x02>;
			qcom,wsi = <&wsi>;
			qcom,wsi_index = <1>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					wifi3_wsi_tx: endpoint {
						remote-endpoint = <&wifi1_wsi_rx>;
					};
				};

				port@1 {
					reg = <1>;

					wifi3_wsi_rx: endpoint {
						remote-endpoint = <&wifi2_wsi_tx>;
					};
				};
			};
		};
	};
};

&wifi5 {
	hremote_node = <&qcn9224_pcie1>;
	board_id = <0x01>;
	hw_link_id = <0 0>;
	status = "okay";
};

&wifi6 {
	hremote_node = <&qcn9224_pcie2>;
	board_id = <0x04>;
	hw_link_id = <1 0>;
	status = "okay";
};

&wifi7 {
	hremote_node = <&qcn9224_pcie3>;
	board_id = <0x02>;
	hw_link_id = <2 0>;
	status = "okay";
};

/*
 * The DS cnss nodes still describe the 36 MB layout at
 * 0x50100000 / 0x52500000 / 0x54900000.  ath12k ignores these properties (see
 * the reserved-memory comment), but they are kept consistent with the 64 MB
 * regions so that no consumer -- current or legacy -- reads a stale address.
 * The arithmetic is base + 0x1100000 (hremote) / 0x800000 (caldb) /
 * 0x100000 (m3 dump) / 0x100000 (etr) / 0x900000 (pageable) = base + 42 MB,
 * inside the 64 MB region.
 *
 * NOTE: these overrides are unconditional and therefore assume the default
 * (non-512 MB) memory profile.  __IPQ_MEM_PROFILE_512_MB__ must not be defined
 * for this device.
 */
&wifi5 {
	base-addr = <0x50100000>;
	caldb-addr = <0x51200000>;
	m3-dump-addr = <0x51a00000>;
	etr-addr = <0x51b00000>;
	pageable-addr = <0x51c00000>;
};

&wifi6 {
	base-addr = <0x54100000>;
	caldb-addr = <0x55200000>;
	m3-dump-addr = <0x55a00000>;
	etr-addr = <0x55b00000>;
	pageable-addr = <0x55c00000>;
};

&wifi7 {
	base-addr = <0x58100000>;
	caldb-addr = <0x59200000>;
	m3-dump-addr = <0x59a00000>;
	etr-addr = <0x59b00000>;
	pageable-addr = <0x59c00000>;
};

/*
 * ---------------------------------------------------------------------------
 * Buttons, LEDs, fan
 * ---------------------------------------------------------------------------
 */

&tlmm {
	button_pins: button-pins {
		pins = "gpio54";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	/*
	 * S1's pwm_pinmux.  The four "pwm" entries prove which pads are routed to
	 * the PWM block; they do NOT prove which PWM channel drives which pad.
	 * gpio40 is configured by the vendor as a pulled-up GPIO inside the same
	 * state and is reproduced here as-is.
	 */
	pwm_pins: pwm-pins {
		mux_red {
			pins = "gpio44";
			function = "pwm";
			drive-strength = <8>;
			bias-disable;
		};

		mux_green {
			pins = "gpio45";
			function = "pwm";
			drive-strength = <8>;
			bias-disable;
		};

		mux_blue {
			pins = "gpio56";
			function = "pwm";
			drive-strength = <8>;
			bias-disable;
		};

		mux_fan {
			pins = "gpio53";
			function = "pwm";
			drive-strength = <8>;
			bias-disable;
		};

		mux_5 {
			pins = "gpio40";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	/*
	 * eMMC pads, identical to the vendor DTB's sdc-default-state: gpio5 clk,
	 * gpio4 cmd, gpio0-3/6-9 data, gpio10 rclk (return clock for HS400).
	 */
	sdc_default_state: sdc-default-state {
		clk-pins {
			pins = "gpio5";
			function = "sdc_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			pins = "gpio4";
			function = "sdc_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			pins = "gpio0", "gpio1", "gpio2",
			       "gpio3", "gpio6", "gpio7",
			       "gpio8", "gpio9";
			function = "sdc_data";
			drive-strength = <8>;
			bias-pull-up;
		};

		rclk-pins {
			pins = "gpio10";
			function = "sdc_rclk";
			drive-strength = <8>;
			bias-pull-down;
		};
	};
};

/*
 * eMMC: the board boots from it, so this controller must be enabled.  Without
 * it there is no /dev/mmcblk0, U-Boot's root=PARTUUID= cannot resolve, and the
 * kernel panics.  Properties mirror rdp437.dts and the vendor DTB.
 */
&sdhc_1 {
	pinctrl-0 = <&sdc_default_state>;
	pinctrl-names = "default";
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	max-frequency = <384000000>;
	bus-width = <8>;
	status = "okay";
};

&pwm {
	pinctrl-0 = <&pwm_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&soc {
	/*
	 * S1 labels this button "wps" with linux,code = KEY_WPS_BUTTON, but its
	 * pinmux group is called "reset_button".  Which function the physical
	 * button really has is UNVERIFIED; see docs/PB_DEVICE_DEFINITION.md.
	 */
	gpio_keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";
		status = "okay";

		button@1 {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&tlmm 54 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			debounce-interval = <60>;
		};
	};

	/*
	 * The vendor disables leds-gpio and drives /sys/class/pwm/pwmchip0 from
	 * a Go daemon (usr/bin/factory-pwm).  A pwm-leds node is the in-kernel
	 * equivalent.  Channel assignment (0=red, 1=green, 2=blue) is UNVERIFIED;
	 * only channel 3 -> fan is proven, by S1's pwm-fan node.  A wrong channel
	 * mapping is cosmetic; it cannot damage the board.
	 */
	leds {
		compatible = "pwm-leds";

		led-red {
			label = "red:system";
			pwms = <&pwm 0 40000 0>;
			default-state = "off";
		};

		led-green {
			label = "green:system";
			pwms = <&pwm 1 40000 0>;
			default-state = "off";
		};

		led-blue {
			label = "blue:system";
			pwms = <&pwm 2 40000 0>;
			default-state = "off";
		};
	};

	/*
	 * S1 verbatim: channel 3, 40 us period, four cooling levels.
	 *
	 * There is no cooling-device link to a thermal zone anywhere in DS/RD/S1,
	 * so with this node alone the fan stays at cooling level 0 (off) unless
	 * userspace drives /sys/class/hwmon/hwmonX/pwm1.  The vendor fills that
	 * gap with its Go daemon.  This build has no equivalent yet -- tracked as
	 * a P-C deliverable and a thermal-safety item in the device-definition doc.
	 */
	pwm-fan {
		compatible = "pwm-fan";
		cooling-min-state = <0>;
		cooling-max-state = <3>;
		pwms = <&pwm 3 40000 0>;
		cooling-levels = <0 0x55 0xaa 0xff>;
		#cooling-cells = <2>;
	};
};

/*
 * DS leaves xo and sleep_clk as fixed-clock with no rate; the board has to
 * supply one.  Without the xo rate sdhci_msm logs "TCXO clk not present
 * (-517)" and the eMMC never initialises ("mmc0: Failed to initialize a
 * non-removable card") -- v50 hardware test, 2026-11-12.  S1: 24 MHz XO,
 * 32 kHz sleep.
 */
&xo {
	clock-frequency = <24000000>;
};

/*
 * sleep_clk deliberately has no rate.  Its only consumer is qcom_wdt
 * (b017000.watchdog), which then stays in deferred probe; the system boots
 * and runs without it (v55 hardware test, 2026-11-13).  A rate here was in
 * every failing DTB.  Re-validate the watchdog in its own cycle rather than
 * coupling it to the boot-blocker workaround below.
 */

/*
 * Disable cpufreq for this board.  Once xo has a rate the CPU clock
 * resolves (apcs-apps-global -> a73pll) and cpufreq-dt comes online; the
 * governor's first dev_pm_opp_set_rate() reprograms the APCS mux and the
 * A73 PLL, and the board dies silently before userland -- v52/v53/v54 all
 * stopped there, v50 (cpufreq could not register at all) and v55 (OPP table
 * absent) both reached userland.  This kernel has no voltage management for
 * these CPUs (CONFIG_QCOM_CPR and CONFIG_QCOM_APM are off), so there is no
 * safe frequency transition to offer anyway; APPSBL already left the cores
 * at a usable rate.  Revisit only together with a working a73pll/cpufreq
 * story.
 */
&CPU0 { /delete-property/ operating-points-v2; };
&CPU1 { /delete-property/ operating-points-v2; };
&CPU2 { /delete-property/ operating-points-v2; };
&CPU3 { /delete-property/ operating-points-v2; };
