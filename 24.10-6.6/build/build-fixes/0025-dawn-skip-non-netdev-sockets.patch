@@ -1808,7 +1809,13 @@
     while ((entry = readdir(dirp)) != NULL) {
         if (entry->d_type == DT_SOCK) {
             bool do_subscribe = true;
-            if (strcmp(entry->d_name, "global") == 0)
+            /* Not every socket in the hostapd control directory is an
