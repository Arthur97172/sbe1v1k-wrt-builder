#!/bin/sh
# WAN eth1 TX 冻结看门狗（24.10-6.6 / NSS 数据通路）。
#
# 背景：持续 NAT 下载后 eth1（WAN，QCA8081 2.5G，SSDK port 5）TX 侧会静默
# 冻结——载波在、速率 2500、RX 仍在走，但 eth1 一个包都发不出去，上游和
# 互联网全部不可达。大部分 in-band 手段无效（txmac 翻转、flowctrl 位改写、
# PHY 关/开、eth1 down/up 整口重建、QM flush、TM DEQ_DIS、QM 时钟门控、
# PSCH TDM slot / L0/L1 flow map 同值重写）。2026-11-26 真机验证：让链路
# 以不同速率重新协商（收窄自协商广告到 1G 再恢复 2.5G）会让楔死 TX 立即
# 复活，2/2 次成功，无需整机重启。
#
# 机制（2026-11-26 源码复核修正）：port5 是 QGMAC + uniphy1 SGMII_CHANNEL0
# （switch_mac_mode1=0x0f、phy-mode "sgmii"），不是 USXGMII；
# adpt_hppe_port_speed_change_port_clock_reset 对 SGMII 分支是空操作。
# 速率变化实际经过 adpt_hppe_sgmii_speed_clock_set ->
# ssdk_port_speed_clock_set（NSSCC port5 RX/TX 时钟重设）+
# ssdk_uniphy1_clock_source_set（uniphy1 TX/RX 时钟源 mux 切到原生时钟）。
# TX 恰在「降到 1G」那一步恢复，卡点定位在 GMAC TX FIFO 与 uniphy1
# SGMII+ 速率适配之间的 TX 方向（时钟来自 NSSCC port5 TX clock）。
# 另注意 adpt_hppe_sgmii_speed_clock_set 没有 FAL_SPEED_2500 分支，
# 2.5G SGMII+ 在 SSDK 时钟表里本就不完整。
#
# 因此做有界自愈：检测到「RX 持续推进而 TX 冻结」并用自己的 ARP 探针确认
# 后，先取证，再原地做一次端口时钟复位（收窄广告 -> 等 1G -> 恢复广告 ->
# 等 2.5G -> ARP 探针再确认）。复位成功则记录 HEALED 继续监控；复位失败
# 才回退到重启。重启/复位次数上限见 /etc/config/sbe_wan_tx_watchdog，防止
# 反复自愈。
#
# 判定：
#   每 15 s 采样 eth1 的 carrier / tx_packets / rx_packets；
#   carrier=1、eth1 有 IPv4 地址、tx 不增且 rx 增量 >0，连续累计 >=90 s
#   判为可疑；随后向 169.254.255.254（假邻居）发 ARP 探针：
#   若探针前后 tx_packets 仍不动 -> 确认冻结 -> 复位/重启。
#   探针把 tx 推动了 -> 误报，清零继续。
# 探针只依赖链路层 ARP，不需要上游/互联网可用。
#
# 安全边界（楔死态实测）：
#   - 只能读 sysfs netdev stats、/sys/ssdk/packet_counter、ssdk_sh debug reg；
#   - 禁止读 /sys/kernel/debug/qca-nss-ppe/*、qca-nss-netfn/flowmgr/stats、
#     ecm/ecm_db/*（会把整机锁死到只能物理断电）。
#   - MAC 内部调试空间没有驱动支持，只能间接读：写 MAC_DBG_ADDR(0x1820)
#     选页、读 MAC_DBG_DATA(0x1824)。这是快照里唯一的写操作（只动调试索引，
#     不碰 MAC 配置寄存器）；每次 ssdk_sh 调用带 5 s 超时，挂住即中止 sweep。
#
# 取证（Stage 1，2026-11-26 起）：标签化寄存器快照追加到 evidence：
#   mac   port5 GMAC：ENABLE 0x1800 / SPEED 0x1804 / CTRL0-2 0x1810-1818 /
#         DBG_CTRL 0x181c（默认 0x80701040）/ DBG_ADDR 0x1820 / DBG_DATA 0x1824
#   qm    q208-q211 AC_UNI_CNT 0x84ed00+16i、q208 DROP_STATE 0x856d00、
#         OQ ENQ 0x85cd00（ENQ_DISABLE bit0）、OQ DEQ 0x864d00（DEQ_DROP bit0）、
#         OQ HEAD 0x86cd00（EMPTY bit0 / TAIL 1-11 / HEAD 12-22）、FLUSH 0x800000
#   tm    PSCH[5] SHP_SIGN 0x470050 / SHP_CREDIT 0x472050 / SHP_CFG 0x474050 /
#         COMP 0x476050（健康 0x18，mode-1 楔死塌成 0x0）
#   sweep MAC 调试空间 0..255 逐项读（写 0x1820 索引后读 0x1824），
#         HEALTHY-BOOT / CONFIRMED / HEALED 三个时点各采一次，可直接对比
#         「冻结前 vs 冻结时 vs 复位后」内部状态哪一位变化。
#   采样点：HEALTHY-BOOT（启动基线）、HEALTHY（周期，不 sweep）、
#   STALL-START（TX 首次停走的那个采样）、SUSPECT、CONFIRMED（全量+sweep，
#   在复位动作之前）、HEALED / HEAL-FAILED（复位后）。
#
# 配置：/etc/config/sbe_wan_tx_watchdog
#   option enabled '1'            # 0 关闭
#   option heal '1'               # 1 先原地复位，0 直接重启
#   option max_heals '3'          # 30 分钟窗口内最多原地复位次数
#   option max_reboots '3'        # 30 分钟窗口内最多自动重启次数
#   option stall_seconds '90'     # TX 冻结累计阈值
#   option macdbg_sweep '1'       # 1 = 基线/冻结/复位后扫 MAC 调试空间 0..255
#   option healthy_interval '1800'# 健康态周期快照间隔（秒），0 关闭

. /lib/functions.sh

CONF=sbe_wan_tx_watchdog
IF=${SBE_TXWD_IF:-eth1}
INTERVAL=15
EVIDENCE=/etc/sbe-wan-tx-watchdog-evidence.log
COUNT=/etc/sbe-wan-tx-watchdog.count
HEALCOUNT=/etc/sbe-wan-tx-watchdog.heal
PROBE_IP=169.254.255.254
PROBE_MAC=02:00:5e:00:53:02

# 复位用 SSDK 端口与自协商广告位图（FAL_PHY_ADV_* 位）。
# full 为 QCA8081 出场广告（ssdk_sh port autoAdv get 5 实测）：
#   2500T_FD|1000T_FD|100TX_FD|100TX_HD|10T_HD|10T_FD|PAUSE|ASY_PAUSE
# narrow 只保留 1000T_FD|PAUSE|ASY_PAUSE，用于制造一次确定的速率变化。
SSDK_PORT=${SBE_TXWD_PORT:-5}
ADV_FULL=0x123f
ADV_NARROW=0x230

log() {
	logger -t sbe-wan-tx-watchdog "$*"
}

ev() {
	log "$*"
	echo "$(date '+%F %T') [$1] uptime=$(cut -d. -f1 /proc/uptime)s tx=$2 rx=$3 carrier=$4" >> "$EVIDENCE" 2>/dev/null
}

case "$(board_name 2>/dev/null)" in
askey,sbe1v1k | spectrum,sbe1v1k) ;;
*) exit 0 ;;
esac

enabled=$(uci -q get $CONF.main.enabled)
[ -n "$enabled" ] || enabled=1
[ "$enabled" = 1 ] || exit 0

heal_enabled=$(uci -q get $CONF.main.heal)
[ -n "$heal_enabled" ] || heal_enabled=1

max=$(uci -q get $CONF.main.max_reboots)
case "$max" in
'' | *[!0-9]*) max=3 ;;
esac

max_heals=$(uci -q get $CONF.main.max_heals)
case "$max_heals" in
'' | *[!0-9]*) max_heals=3 ;;
esac

stall_need=$(uci -q get $CONF.main.stall_seconds)
case "$stall_need" in
'' | *[!0-9]*) stall_need=90 ;;
esac
[ "$stall_need" -ge 60 ] || stall_need=60

macdbg_en=$(uci -q get $CONF.main.macdbg_sweep)
case "$macdbg_en" in
'' | *[!0-9]*) macdbg_en=1 ;;
esac

healthy_interval=$(uci -q get $CONF.main.healthy_interval)
case "$healthy_interval" in
'' | *[!0-9]*) healthy_interval=1800 ;;
esac

[ -d "/sys/class/net/$IF" ] || exit 0

# 计数文件：第一行上次动作时间，第二行 30 分钟窗口内次数。
# reboots_allowed / heals_allowed 超限时只告警不动作。
count_check() {
	local file limit label now last cnt
	file=$1
	limit=$2
	label=$3
	now=$(date +%s)
	last=0
	cnt=0
	[ -r "$file" ] && {
		read -r last <"$file"
		cnt=$(sed -n 2p "$file" 2>/dev/null)
	}
	case "$last" in '' | *[!0-9]*) last=0 ;; esac
	case "$cnt" in '' | *[!0-9]*) cnt=0 ;; esac
	if [ $((now - last)) -gt 1800 ]; then
		cnt=0
	fi
	[ "$cnt" -lt "$limit" ] && return 0
	log "CRITICAL: $label 已达上限（${cnt}/${limit}，30 分钟内），不再自动执行"
	return 1
}

count_bump() {
	local file now cnt
	file=$1
	now=$(date +%s)
	cnt=0
	[ -r "$file" ] && cnt=$(sed -n 2p "$file" 2>/dev/null)
	case "$cnt" in '' | *[!0-9]*) cnt=0 ;; esac
	cnt=$((cnt + 1))
	printf '%s\n%s\n' "$now" "$cnt" >"$file"
}

has_ipv4() {
	ip -4 addr show dev "$IF" 2>/dev/null | grep -q 'inet '
}

snap() {
	T=$(cat "/sys/class/net/$IF/statistics/tx_packets" 2>/dev/null)
	R=$(cat "/sys/class/net/$IF/statistics/rx_packets" 2>/dev/null)
	C=$(cat "/sys/class/net/$IF/carrier" 2>/dev/null)
}

# ---- Stage 1 取证：标签化寄存器快照 ----
# 每次 ssdk_sh 调用最多 5 s。楔死态某次寄存器读若卡在驱动里，SIGTERM 也
# 杀不掉，所以优先用 timeout -k 再补 KILL；启动时探测一次是否支持 -k。
TIMEOUT=""
if command -v timeout >/dev/null 2>&1; then
	TIMEOUT="timeout 5"
	timeout -k 2 5 true >/dev/null 2>&1 && TIMEOUT="timeout -k 2 5"
fi

runc() {
	[ -n "$TIMEOUT" ] && {
		$TIMEOUT "$@"
		return $?
	}
	"$@"
}

sreg() {
	runc ssdk_sh debug reg get "$1" 4 2>&1 | grep -o 'Data\]:0x[0-9a-f]*' | cut -d: -f2
}

# evidence 超过 1 MiB 轮转一次（周期快照会长期增长）。
cap_evidence() {
	local size
	[ -f "$EVIDENCE" ] || return 0
	size=$(wc -c <"$EVIDENCE" 2>/dev/null)
	case "$size" in '' | *[!0-9]*) return 0 ;; esac
	[ "$size" -gt 1048576 ] && mv -f "$EVIDENCE" "$EVIDENCE.1" 2>/dev/null
}

# MAC 内部调试空间 sweep：写索引寄存器 MAC_DBG_ADDR(0x1820) 选页，
# 读 MAC_DBG_DATA(0x1824)。唯一写操作只动调试索引；结束后恢复原索引。
# 任何一次读取超时/失败即中止（说明 SSDK 可能卡住，不再加压）。
sweep_macdbg() {
	local i orig v
	orig=$(sreg 0x1820)
	echo "macdbg_orig=$orig"
	i=0
	while [ "$i" -le 255 ]; do
		runc ssdk_sh debug reg set 0x1820 "$i" 4 >/dev/null 2>&1
		v=$(sreg 0x1824)
		if [ -z "$v" ]; then
			echo "macdbg[$i]=<timeout-or-error> sweep-aborted"
			break
		fi
		printf 'macdbg[%03d]=%s\n' "$i" "$v"
		i=$((i + 1))
	done
	[ -n "$orig" ] && runc ssdk_sh debug reg set 0x1820 "$orig" 4 >/dev/null 2>&1
	return 0
}

# snap_regs <label> <sweep 0|1>：追加一块带标签的取证到 evidence。
snap_regs() {
	local label=$1 sweep=$2
	snap
	cap_evidence
	{
		echo "== [$label] $(date '+%F %T') uptime=$(cut -d. -f1 /proc/uptime)s tx=$T rx=$R carrier=$C"
		echo "speed=$(cat /sys/class/net/$IF/speed 2>/dev/null) carrier_changes=$(cat /sys/class/net/$IF/carrier_changes 2>/dev/null) tx_errors=$(cat /sys/class/net/$IF/statistics/tx_errors 2>/dev/null) tx_dropped=$(cat /sys/class/net/$IF/statistics/tx_dropped 2>/dev/null)"
		if command -v ssdk_sh >/dev/null 2>&1; then
			echo "mac: en=$(sreg 0x1800) spd=$(sreg 0x1804) ctrl0=$(sreg 0x1810) ctrl1=$(sreg 0x1814) ctrl2=$(sreg 0x1818) dbg_ctl=$(sreg 0x181c)"
			echo "qm: q208=$(sreg 0x84ed00) q209=$(sreg 0x84ed10) q210=$(sreg 0x84ed20) q211=$(sreg 0x84ed30)"
			echo "qm: drop208=$(sreg 0x856d00) oq_enq=$(sreg 0x85cd00) oq_deq=$(sreg 0x864d00) oq_head=$(sreg 0x86cd00) flush=$(sreg 0x800000)"
			echo "tm: shp_sign5=$(sreg 0x470050) shp_credit5=$(sreg 0x472050) shp_cfg5=$(sreg 0x474050) comp5=$(sreg 0x476050)"
			echo "--- packet_counter (port tx/rx, queue tx, drop) ---"
			grep -E 'PORT_TX_COUNTER|PORT_RX_COUNTER|QUEUE_TX_COUNTER|DROP_CPU' /sys/ssdk/packet_counter 2>/dev/null
			[ "$sweep" = 1 ] && sweep_macdbg
		else
			echo "(ssdk_sh unavailable)"
		fi
	} >>"$EVIDENCE" 2>/dev/null
}

# ARP 探针：把假邻居钉在 eth1 上再 ping，内核必须为它发出 ARP 请求
# （走 eth1 的 TX），不需要任何上游可用。返回 0 表示 TX 仍冻结。
probe_tx() {
	local before after
	snap
	before=$T
	ip neigh replace "$PROBE_IP" lladdr "$PROBE_MAC" dev "$IF" nud permanent 2>/dev/null
	ping -c 3 -W 1 -I "$IF" "$PROBE_IP" >/dev/null 2>&1
	sleep 2
	snap
	after=$T
	ip neigh del "$PROBE_IP" dev "$IF" 2>/dev/null
	[ -n "$before" ] && [ -n "$after" ] && [ "$before" = "$after" ]
}

speed_now() {
	cat "/sys/class/net/$IF/speed" 2>/dev/null
}

# wait_speed <Mbps> <秒>：等到 eth1 报告目标速率，成功返回 0。
wait_speed() {
	local want=$1 deadline=$2 s
	s=$(speed_now)
	[ "$s" = "$want" ] && return 0
	while [ "$deadline" -gt 0 ]; do
		sleep 1
		deadline=$((deadline - 1))
		s=$(speed_now)
		[ "$s" = "$want" ] && return 0
	done
	return 1
}

# heal_tx：原地端口时钟复位。先收窄自协商广告让链路降速，再恢复，
# 两次速率变化都会让 SSDK 复位 MAC 与端口 TX/RX。无论中途成败都尝试
# 恢复广告；最后用 ARP 探针确认 TX 复活。成功返回 0。
heal_tx() {
	command -v ssdk_sh >/dev/null 2>&1 || return 1

	ssdk_sh port autoAdv set "$SSDK_PORT" "$ADV_NARROW" >/dev/null 2>&1
	ssdk_sh port autoNeg restart "$SSDK_PORT" >/dev/null 2>&1
	wait_speed 1000 15
	ssdk_sh port autoAdv set "$SSDK_PORT" "$ADV_FULL" >/dev/null 2>&1
	ssdk_sh port autoNeg restart "$SSDK_PORT" >/dev/null 2>&1
	wait_speed 2500 15
	sleep 2
	# probe_tx 返回 0（TX 仍冻结）即复位失败。
	probe_tx && return 1
	return 0
}

log "启动：if=$IF 间隔=${INTERVAL}s 阈值=${stall_need}s 复位=${heal_enabled} 复位上限=${max_heals} 重启上限=${max} macdbg=${macdbg_en} 健康快照=${healthy_interval}s"

# 启动基线：健康态（sweep 可选）——之后与冻结态逐项对比。
snap_regs "HEALTHY-BOOT" "$macdbg_en"

prev_tx=
prev_rx=
stall=0
last_healthy=$(date +%s)
last_stall_start=0
while :; do
	sleep "$INTERVAL"
	snap
	[ -n "$T" ] || continue
	# 启动早期与无地址阶段不做判定：eth1 还没拿到地址时 ARP 探针没有源地址。
	if [ "$C" != "1" ] || ! has_ipv4; then
		stall=0
		prev_tx=$T
		prev_rx=$R
		continue
	fi
	if [ -n "$prev_tx" ] && [ "$T" = "$prev_tx" ] && [ "$R" -gt "$prev_rx" ]; then
		# TX 第一次停走的那个采样最接近「冻结瞬间」，单独留档。
		# 限频 300 s：TX 零星吐包会让 stall 反复归零，避免刷爆 evidence。
		if [ "$stall" -eq 0 ]; then
			now=$(date +%s)
			if [ $((now - last_stall_start)) -ge 300 ]; then
				snap_regs "STALL-START" 0
				last_stall_start=$now
			fi
		fi
		stall=$((stall + INTERVAL))
	else
		stall=0
	fi
	if [ "$healthy_interval" -gt 0 ] && [ "$stall" -eq 0 ]; then
		now=$(date +%s)
		if [ $((now - last_healthy)) -ge "$healthy_interval" ]; then
			snap_regs "HEALTHY" 0
			last_healthy=$now
		fi
	fi
	if [ "$stall" -ge "$stall_need" ]; then
		ev "SUSPECT" "$T" "$R" "$C"
		snap_regs "SUSPECT" 0
		if probe_tx; then
			snap
			ev "CONFIRMED" "$T" "$R" "$C"
			# 全量取证（含 MAC 调试空间 sweep），必须在复位动作之前。
			snap_regs "CONFIRMED" "$macdbg_en"
			healed=0
			heal_tried=0
			if [ "$heal_enabled" = 1 ] && count_check "$HEALCOUNT" "$max_heals" "原地复位"; then
				heal_tried=1
				count_bump "$HEALCOUNT"
				log "TX 冻结已确认（tx=$T 不动）；尝试原地端口时钟复位"
				if heal_tx; then
					healed=1
				fi
				snap
				[ "$healed" = 1 ] && {
					ev "HEALED" "$T" "$R" "$C"
					log "原地复位成功：speed=$(speed_now) tx=$T 已恢复"
					snap_regs "HEALED" "$macdbg_en"
				}
			fi
			if [ "$healed" = 0 ]; then
				[ "$heal_tried" = 1 ] && {
					ev "HEAL-FAILED" "$T" "$R" "$C"
					snap_regs "HEAL-FAILED" 0
				}
				[ "$heal_enabled" = 1 ] && [ "$heal_tried" = 0 ] &&
					ev "HEAL-SKIP" "$T" "$R" "$C"
				if count_check "$COUNT" "$max" "自动重启"; then
					count_bump "$COUNT"
					log "原地复位未恢复 TX；取证已落盘，重启自愈"
					sync
					sleep 1
					reboot
					sleep 60
				fi
			fi
		else
			ev "PROBE-OK" "$T" "$R" "$C"
			log "TX 冻结疑似误报：ARP 探针成功发出，清零继续"
		fi
		stall=0
	fi
	prev_tx=$T
	prev_rx=$R
done
