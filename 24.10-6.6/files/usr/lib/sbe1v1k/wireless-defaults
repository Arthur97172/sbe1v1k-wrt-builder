#!/bin/sh
# Apply wireless defaults once, after all radios exist on the target platform.
#
# Supported boards:
#   - spectrum,sbe1v1k
#
# Design:
#   1. Check whether the current board is supported.
#   2. Wait for OpenWrt/mac80211 to discover all available radios/interfaces.
#   3. Dynamically configure only the bands that actually exist.
#   4. Protect discovered 6 GHz interfaces before applying the final policy.
#   5. Commit wireless configuration.
#   6. Mark the policy as applied only after successful configuration.

set -eu

###############################################################################
# Global configuration
###############################################################################

MARKER='system.@system[0].spectrum_wireless_defaults'
MAX_ATTEMPTS="${WIFI_WAIT_ATTEMPTS:-30}"
WIFI_COUNTRY="${WIFI_COUNTRY:-TW}"

# 2.4 GHz
WIFI_2G_CHANNEL="${WIFI_2G_CHANNEL:-11}"
WIFI_2G_HTMODE="${WIFI_2G_HTMODE:-EHT40}"
WIFI_2G_TXPOWER="${WIFI_2G_TXPOWER:-23}"
WIFI_2G_SSID="${WIFI_2G_SSID:-WiFi_2.4G}"

# 5 GHz
WIFI_5G_CHANNEL="${WIFI_5G_CHANNEL:-40}"
WIFI_5G_HTMODE="${WIFI_5G_HTMODE:-EHT80}"
WIFI_5G_TXPOWER="${WIFI_5G_TXPOWER:-23}"
WIFI_5G_SSID="${WIFI_5G_SSID:-WiFi_5G}"

# 6 GHz
WIFI_6G_CHANNEL="${WIFI_6G_CHANNEL:-61}"
WIFI_6G_HTMODE="${WIFI_6G_HTMODE:-EHT320}"
WIFI_6G_TXPOWER="${WIFI_6G_TXPOWER:-23}"
WIFI_6G_SSID="${WIFI_6G_SSID:-WiFi_6G}"

WIFI_KEY="${WIFI_KEY:-12345678}"

# The ath12k firmware on this board reports one placeholder MAC
# (00:03:7f:12:34:56) for the wiphy and for every entry of its per-radio
# address list, so the band vifs are created with identical MACs and only the
# first one can be brought up.  A band iface whose macaddr is still missing or
# the placeholder gets one derived from the lowest Ethernet MAC, offset by
# band (2.4G +0x10, 5G +0x11, 6G +0x12) so the three bands stay distinct and
# away from the Ethernet addresses.
WIFI_MAC_PLACEHOLDER_PREFIX='00:03:7f:'
WIFI_MAC_OFFSET_2G=16
WIFI_MAC_OFFSET_5G=17
WIFI_MAC_OFFSET_6G=18

###############################################################################
# Board detection
###############################################################################

get_board_name() {
	if [ -r /tmp/sysinfo/board_name ]; then
		cat /tmp/sysinfo/board_name
	elif command -v board_name >/dev/null 2>&1; then
		command board_name
	else
		return 1
	fi
}

is_supported_board() {
	local board

	board="$(get_board_name 2>/dev/null || true)"

	case "$board" in
		spectrum,sbe1v1k)
			return 0
			;;
		*)
			return 1
			;;
	esac
}

###############################################################################
# Wireless UCI discovery helpers
###############################################################################

radios_for_band() {
	uci -q show wireless 2>/dev/null |
		sed -n \
			-e "s/^wireless\.\([^.=]*\)\.band='$1'$/\1/p" \
			-e "s/^wireless\.\([^.=]*\)\.band=$1$/\1/p"
}

ifaces_for_radio() {
	uci -q show wireless 2>/dev/null |
		sed -n \
			-e "s/^wireless\.\([^.=]*\)\.device='$1'$/\1/p" \
			-e "s/^wireless\.\([^.=]*\)\.device=$1$/\1/p"
}

###############################################################################
# UCI helpers
###############################################################################

delete_if_present() {
	uci -q delete "$1" >/dev/null 2>&1 || true
}

get_uci_value() {
	uci -q get "$1" 2>/dev/null || true
}

set_if_changed() {
	local option="$1"
	local value="$2"
	local current

	current="$(get_uci_value "$option")"

	[ "$current" = "$value" ] || uci -q set "$option"="$value"
}

# Set by the repair helpers below; committed and reloaded once, at the end.
WIRELESS_CHANGED=0

mark_wireless_changed() {
	WIRELESS_CHANGED=1
}

###############################################################################
# QSDK band-split radios
###############################################################################
#
# /sbin/wifi config (QSDK mac80211.uc) turns the single wiphy into one
# wifi-device per hardware band, named radioX_bandN, each carrying
# `option band` plus that band's channel list in `option channels`.
#
# LuCI's radio dialog cannot round-trip those sections: iwinfo only knows the
# wiphy ifname and returns the first band for every section name, so the Band
# select ends up empty (or wrong), and uci.set(section, 'band', '') deletes
# the option when the dialog is saved.  The radio then fails to come up until
# `band` is restored.  The repair below runs on every boot and only touches a
# section whose band is missing; a configured band is never rewritten.

all_wifi_devices() {
	uci -q show wireless 2>/dev/null |
		sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'
}

band_from_channels() {
	local rng hi max=""

	for rng in $1; do
		case "$rng" in
			*-*) hi="${rng##*-}" ;;
			*) hi="$rng" ;;
		esac

		case "$hi" in
			''|*[!0-9]*) continue ;;
		esac

		if [ -z "$max" ] || [ "$hi" -gt "$max" ]; then
			max="$hi"
		fi
	done

	[ -n "$max" ] || return 1

	if [ "$max" -le 14 ]; then
		printf '2g\n'
	elif [ "$max" -le 196 ]; then
		printf '5g\n'
	else
		printf '6g\n'
	fi
}

default_channel_for_band() {
	case "$1" in
		2g) printf '%s\n' "$WIFI_2G_CHANNEL" ;;
		5g) printf '%s\n' "$WIFI_5G_CHANNEL" ;;
		6g) printf '%s\n' "$WIFI_6G_CHANNEL" ;;
	esac
}

repair_band_splits() {
	local radio band channel changed=0

	for radio in $(all_wifi_devices); do
		case "$radio" in
			radio*_band*) ;;
			*) continue ;;
		esac

		band="$(get_uci_value "wireless.$radio.band")"

		if [ -z "$band" ]; then
			band="$(band_from_channels "$(get_uci_value "wireless.$radio.channels")" || true)"
			[ -n "$band" ] || continue

			uci -q set "wireless.$radio.band"="$band"
			changed=1
			logger -t wireless-defaults "restored band=$band on $radio"

			# The band and channel were deleted together by the same LuCI
			# save; restore the policy channel when it is missing too, but
			# never rewrite a channel on a section whose band was intact.
			if [ -z "$(get_uci_value "wireless.$radio.channel")" ]; then
				channel="$(default_channel_for_band "$band")"

				if [ -n "$channel" ]; then
					uci -q set "wireless.$radio.channel"="$channel"
				fi
			fi
		fi
	done

	if [ "$changed" -eq 1 ]; then
		mark_wireless_changed
	fi
}

###############################################################################
# Per-band Wi-Fi MAC repair
###############################################################################

# Lowest non-placeholder Ethernet MAC.  Fixed-width lowercase hex strings sort
# in MAC order, so `sort` yields the numerically lowest address; eth0 carries
# the board's base MAC and br-lan is only a fallback.
wifi_base_mac() {
	local mac best="" brlan

	for mac in $(for f in /sys/class/net/eth*/address; do
		[ -r "$f" ] && cat "$f"
	done | tr 'A-F' 'a-f' | sort); do
		[ "$mac" != "00:00:00:00:00:00" ] || continue
		best="$mac"
		break
	done

	if [ -z "$best" ] && [ -r /sys/class/net/br-lan/address ]; then
		brlan="$(tr 'A-F' 'a-f' < /sys/class/net/br-lan/address)"
		[ "$brlan" != "00:00:00:00:00:00" ] && best="$brlan"
	fi

	[ -n "$best" ] || return 1
	printf '%s\n' "$best"
}

# mac_add_offset <mac> <offset>: add offset to the last octet, carrying left.
mac_add_offset() {
	local mac="$1" offset="$2"
	local o1 o2 o3 o4 o5 o6 carry
	local IFS=:

	set -- $mac
	[ $# -eq 6 ] || return 1

	o1=$((0x$1)); o2=$((0x$2)); o3=$((0x$3))
	o4=$((0x$4)); o5=$((0x$5)); o6=$((0x$6))

	o6=$((o6 + offset)); carry=$((o6 / 256)); o6=$((o6 % 256))
	o5=$((o5 + carry)); carry=$((o5 / 256)); o5=$((o5 % 256))
	o4=$((o4 + carry)); carry=$((o4 / 256)); o4=$((o4 % 256))
	o3=$((o3 + carry)); carry=$((o3 / 256)); o3=$((o3 % 256))
	o2=$((o2 + carry)); carry=$((o2 / 256)); o2=$((o2 % 256))
	o1=$((o1 + carry)); o1=$((o1 % 256))

	printf '%02x:%02x:%02x:%02x:%02x:%02x\n' \
		"$o1" "$o2" "$o3" "$o4" "$o5" "$o6"
}

band_mac_offset() {
	case "$1" in
		2g) printf '%s\n' "$WIFI_MAC_OFFSET_2G" ;;
		5g) printf '%s\n' "$WIFI_MAC_OFFSET_5G" ;;
		6g) printf '%s\n' "$WIFI_MAC_OFFSET_6G" ;;
		*) return 1 ;;
	esac
}

repair_band_macaddrs() {
	local base band offset wanted radio iface current

	base="$(wifi_base_mac)" || return 0

	for band in 2g 5g 6g; do
		offset="$(band_mac_offset "$band")" || continue
		wanted="$(mac_add_offset "$base" "$offset")" || continue
		[ -n "$wanted" ] || continue

		for radio in $(radios_for_band "$band"); do
			for iface in $(ifaces_for_radio "$radio"); do
				current="$(get_uci_value "wireless.$iface.macaddr")"

				# Only replace an address that was never set or that is
				# still the ath12k placeholder; a configured MAC wins.
				case "$current" in
					''|'00:00:00:00:00:00')
						;;
					"$WIFI_MAC_PLACEHOLDER_PREFIX"*)
						;;
					*)
						continue
						;;
				esac

				uci -q set "wireless.$iface.macaddr"="$wanted"
				mark_wireless_changed
				logger -t wireless-defaults \
					"assigned MAC $wanted to $iface ($band)"
			done
		done
	done
}

###############################################################################
# 6 GHz availability repair
###############################################################################
#
# ath12k takes its self-managed regulatory rules from the firmware, and the
# firmware shipped for this board has no 6 GHz channels for some countries
# (TW among them): every 6 GHz channel is `(disabled)` and the 6 GHz pdev is
# rejected with "pdev is not supported for this country" when the radio is
# started.  Keep that radio disabled so hostapd is not asked to start a band
# that cannot exist; the check runs every boot, so a country change or a
# firmware update flips it back automatically.

repair_6g_availability() {
	local radio phy_info

	radio="$(radios_for_band 6g | head -n 1)"
	[ -n "$radio" ] || return 0

	phy_info="$(iw phy 2>/dev/null || true)"

	# No phy yet (first boot, driver not loaded): the firmware's view cannot
	# be probed, so stay undecided and re-check on the next boot.
	[ -n "$phy_info" ] || return 0

	if printf '%s\n' "$phy_info" |
		grep -qE '\* 59[0-9][0-9]\.[0-9]+ MHz \[[0-9]+\] \([0-9.]+ dBm'; then
		if [ "$(get_uci_value "wireless.$radio.spectrum_6g_fw_blocked")" = "1" ]; then
			delete_if_present "wireless.$radio.disabled"
			delete_if_present "wireless.$radio.spectrum_6g_fw_blocked"
			mark_wireless_changed
			logger -t wireless-defaults \
				"6 GHz channels available again; re-enabled $radio"
		fi
	else
		if [ "$(get_uci_value "wireless.$radio.disabled")" != "1" ] ||
			[ "$(get_uci_value "wireless.$radio.spectrum_6g_fw_blocked")" != "1" ]; then
			uci -q set "wireless.$radio.disabled"='1'
			uci -q set "wireless.$radio.spectrum_6g_fw_blocked"='1'
			mark_wireless_changed
			logger -t wireless-defaults \
				"no enabled 6 GHz channel for this country; disabled radio $radio"
		fi
	fi
}

###############################################################################
# Wireless discovery completeness
###############################################################################

wireless_is_complete() {
	local band radio radios ifaces
	local found_any=0

	for band in 2g 5g 6g; do
		radios="$(radios_for_band "$band")"

		if [ -n "$radios" ]; then
			found_any=1

			for radio in $radios; do
				ifaces="$(ifaces_for_radio "$radio")"

				[ -n "$ifaces" ] || return 1
			done
		fi
	done

	[ "$found_any" -eq 1 ] || return 1
}

###############################################################################
# 6 GHz safety protection
###############################################################################

safeguard_discovered_6g() {
	local radio iface current key_line changed=0

	for radio in $(radios_for_band 6g); do
		for iface in $(ifaces_for_radio "$radio"); do
			current="$(get_uci_value "wireless.$iface.disabled")"

			if [ "$current" != "1" ]; then
				uci -q set wireless."$iface".disabled='1'
				changed=1
			fi

			key_line="$(get_uci_value "wireless.$iface.key")"
			if [ -n "$key_line" ] && [ -z "$(printf '%s' "$key_line" | tr -d '[:space:]')" ]; then
				delete_if_present "wireless.$iface.key"
				changed=1
			fi
		done
	done

	if [ "$changed" -eq 1 ]; then
		uci -q commit wireless
	fi
}

###############################################################################
# Common AP configuration
###############################################################################

apply_ap_common() {
	local iface="$1"

	set_if_changed "wireless.$iface.uapsd" "0"
	set_if_changed "wireless.$iface.disassoc_low_ack" "0"
	set_if_changed "wireless.$iface.ieee80211k" "1"
	set_if_changed "wireless.$iface.rrm_neighbor_report" "1"
	set_if_changed "wireless.$iface.rrm_beacon_report" "1"
	set_if_changed "wireless.$iface.bss_transition" "1"
	set_if_changed "wireless.$iface.disabled" "0"
}

###############################################################################
# 2.4 GHz policy
###############################################################################

apply_2g_policy() {
	local radio iface

	for radio in $(radios_for_band 2g); do
		set_if_changed "wireless.$radio.country" "$WIFI_COUNTRY"
		set_if_changed "wireless.$radio.channel" "$WIFI_2G_CHANNEL"
		set_if_changed "wireless.$radio.htmode" "$WIFI_2G_HTMODE"
		set_if_changed "wireless.$radio.txpower" "$WIFI_2G_TXPOWER"
		set_if_changed "wireless.$radio.he_mu_beamformer" "0"
		set_if_changed "wireless.$radio.he_su_beamformer" "1"

		for iface in $(ifaces_for_radio "$radio"); do
			[ "$(get_uci_value "wireless.$iface.mode")" = "ap" ] || continue

			set_if_changed "wireless.$iface.ssid" "$WIFI_2G_SSID"
			set_if_changed "wireless.$iface.encryption" "sae-mixed"
			set_if_changed "wireless.$iface.key" "$WIFI_KEY"

			apply_ap_common "$iface"

			set_if_changed "wireless.$iface.ieee80211r" "0"
			delete_if_present "wireless.$iface.mobility_domain"
			delete_if_present "wireless.$iface.ft_over_ds"
			delete_if_present "wireless.$iface.ft_psk_generate_local"
		done
	done
}

###############################################################################
# 5 GHz policy
###############################################################################

apply_5g_policy() {
	local radio iface

	for radio in $(radios_for_band 5g); do
		set_if_changed "wireless.$radio.country" "$WIFI_COUNTRY"
		set_if_changed "wireless.$radio.channel" "$WIFI_5G_CHANNEL"
		set_if_changed "wireless.$radio.htmode" "$WIFI_5G_HTMODE"
		set_if_changed "wireless.$radio.txpower" "$WIFI_5G_TXPOWER"
		set_if_changed "wireless.$radio.he_su_beamformer" "1"
		set_if_changed "wireless.$radio.he_mu_beamformer" "1"
		set_if_changed "wireless.$radio.eht_su_beamformer" "1"
		set_if_changed "wireless.$radio.eht_mu_beamformer" "1"
		set_if_changed "wireless.$radio.he_bss_color" "2"
		set_if_changed "wireless.$radio.background_radar" "1"

		for iface in $(ifaces_for_radio "$radio"); do
			[ "$(get_uci_value "wireless.$iface.mode")" = "ap" ] || continue

			set_if_changed "wireless.$iface.ssid" "$WIFI_5G_SSID"
			set_if_changed "wireless.$iface.encryption" "sae-mixed"
			set_if_changed "wireless.$iface.key" "$WIFI_KEY"

			apply_ap_common "$iface"

			set_if_changed "wireless.$iface.max_inactivity" "86400"
			set_if_changed "wireless.$iface.ieee80211r" "1"
			set_if_changed "wireless.$iface.mobility_domain" "6616"
			set_if_changed "wireless.$iface.ft_over_ds" "0"
			set_if_changed "wireless.$iface.ft_psk_generate_local" "1"
		done
	done
}

###############################################################################
# 6 GHz policy
###############################################################################

apply_6g_policy() {
	local radio iface

	for radio in $(radios_for_band 6g); do
		set_if_changed "wireless.$radio.country" "$WIFI_COUNTRY"
		set_if_changed "wireless.$radio.band" "6g"
		set_if_changed "wireless.$radio.channel" "$WIFI_6G_CHANNEL"
		set_if_changed "wireless.$radio.htmode" "$WIFI_6G_HTMODE"
		set_if_changed "wireless.$radio.txpower" "$WIFI_6G_TXPOWER"
		set_if_changed "wireless.$radio.eht_su_beamformer" "1"
		set_if_changed "wireless.$radio.eht_mu_beamformer" "1"
		set_if_changed "wireless.$radio.he_su_beamformer" "1"
		set_if_changed "wireless.$radio.he_mu_beamformer" "1"
		set_if_changed "wireless.$radio.he_bss_color" "1"

		for iface in $(ifaces_for_radio "$radio"); do
			set_if_changed "wireless.$iface.mode" "ap"
			set_if_changed "wireless.$iface.network" "lan"
			set_if_changed "wireless.$iface.ssid" "$WIFI_6G_SSID"
			set_if_changed "wireless.$iface.encryption" "sae"
			set_if_changed "wireless.$iface.key" "$WIFI_KEY"
			set_if_changed "wireless.$iface.ieee80211w" "2"

			delete_if_present "wireless.$iface.mesh_id"
			delete_if_present "wireless.$iface.mesh_fwding"
			delete_if_present "wireless.$iface.wds"
			delete_if_present "wireless.$iface.owe_groups"
			delete_if_present "wireless.$iface.owe_transition_ifname"
			delete_if_present "wireless.$iface.owe_transition_ssid"

			apply_ap_common "$iface"

			set_if_changed "wireless.$iface.ieee80211r" "1"
			set_if_changed "wireless.$iface.mobility_domain" "6616"
			set_if_changed "wireless.$iface.ft_over_ds" "0"
			set_if_changed "wireless.$iface.ft_psk_generate_local" "1"
		done
	done
}

###############################################################################
# Apply complete wireless policy
###############################################################################

# The QSDK generator writes `disabled='1'` into every radio it creates (the
# operator is expected to enable them from LuCI).  Our policy enables the APs,
# so the device-level flag has to go as well; otherwise every network renders
# as 已禁用 and `wifi up` keeps the radios down until someone toggles them.
enable_radios() {
	local band radio

	for band in 2g 5g 6g; do
		for radio in $(radios_for_band "$band"); do
			delete_if_present "wireless.$radio.disabled"
		done
	done
}

apply_policy() {
	if ! is_supported_board; then
		return 1
	fi

	apply_2g_policy
	apply_5g_policy
	apply_6g_policy
	enable_radios

	# The band ifaces exist by now; give each one a distinct MAC before the
	# policy is committed so the first start of every radio is already clean.
	repair_band_macaddrs

	uci -q commit wireless
	uci -q set "$MARKER"='1'
	uci -q commit system
}

###############################################################################
# Main
###############################################################################

if ! is_supported_board; then
	exit 0
fi

# Runs before the marker check: a band lost to a LuCI radio-dialog save, a
# placeholder Wi-Fi MAC, or a 6 GHz band the firmware cannot serve must be
# repaired even on an installation whose policy was applied long ago.
repair_band_splits
repair_band_macaddrs
repair_6g_availability

if [ "$WIRELESS_CHANGED" -eq 1 ]; then
	uci -q commit wireless
	# netifd re-reads /etc/config/wireless and restarts only the affected
	# radios.  /sbin/wifi reload is not usable in this QSDK stack: it calls
	# an undefined pre_wifi_reload_legacy hook and aborts before doing
	# anything.
	ubus call network reload >/dev/null 2>&1 || true

	# The running phy reflects the configured country only after the reload
	# above; re-check the 6 GHz band once so a country change takes effect
	# in the same boot instead of on the next one.
	sleep 2
	WIRELESS_CHANGED=0
	repair_6g_availability

	if [ "$WIRELESS_CHANGED" -eq 1 ]; then
		uci -q commit wireless
		ubus call network reload >/dev/null 2>&1 || true
	fi
fi

if [ "$(get_uci_value "$MARKER")" = "1" ]; then
	exit 0
fi

case "$MAX_ATTEMPTS" in
	''|*[!0-9]*)
		MAX_ATTEMPTS=30
		;;
esac

[ "$MAX_ATTEMPTS" -gt 0 ] || MAX_ATTEMPTS=1

attempt=1

while :; do
	if command -v wifi >/dev/null 2>&1; then
		wifi config >/dev/null 2>&1 || true
	fi

	safeguard_discovered_6g

	if wireless_is_complete; then
		if apply_policy; then
			# Radios were created disabled by the QSDK generator, so the
			# `wifi up` that ran earlier in boot skipped them.  Re-apply the
			# committed configuration now that the device flags are gone.
			wifi reload >/dev/null 2>&1 || true
			exit 0
		fi
	fi

	if [ "$attempt" -ge "$MAX_ATTEMPTS" ]; then
		break
	fi

	attempt=$((attempt + 1))
	sleep 1
done

printf '%s\n' \
	'Wireless defaults: Wireless configuration could not be fully generated; will retry next boot' >&2

exit 1
